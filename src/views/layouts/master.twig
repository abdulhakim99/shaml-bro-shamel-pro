{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            /* Theme specific variables */
            --s-radius: .75rem;
        }
    </style>
    <style>
      .shamel-news{overflow:hidden;background:linear-gradient(90deg,#071a2f,#0f4c6b,#071a2f);color:#fff;padding:.58rem 0;font-size:.84rem;font-weight:700;white-space:nowrap}
      .shamel-news__track{display:flex;width:max-content;gap:4rem;animation:shamel-news 24s linear infinite}
      .shamel-news--slow .shamel-news__track{animation-duration:36s}.shamel-news--fast .shamel-news__track{animation-duration:15s}
      .shamel-news__track span{padding-inline:2rem}
      @keyframes shamel-news{to{transform:translateX(33.333%)}}
      html[dir=ltr] .shamel-news__track{animation-direction:reverse}
      .shamel-follow{margin-top:3rem;padding:2.25rem 0;background:linear-gradient(135deg,#071a2f,#0f4c6b);color:#fff}
      .shamel-follow__inner{display:flex;align-items:center;justify-content:space-between;gap:1.5rem}.shamel-follow h2{margin:0 0 .4rem;font-size:1.45rem;font-weight:800}.shamel-follow p{margin:0;color:rgba(255,255,255,.75)}
      .shamel-follow__links{display:flex;flex-wrap:wrap;gap:.65rem}.shamel-follow__links a{display:grid;place-items:center;width:3rem;height:3rem;border:1px solid rgba(255,255,255,.25);border-radius:.8rem;background:rgba(255,255,255,.1);color:#fff;font-size:1.25rem;transition:.2s}.shamel-follow__links a:hover{transform:translateY(-3px);background:#fff;color:#0f4c6b}
      .shamel-popup[hidden]{display:none}.shamel-popup{position:fixed;inset:0;z-index:120;display:grid;place-items:center;padding:1rem;background:rgba(2,6,23,.66);backdrop-filter:blur(5px)}
      .shamel-popup__card{position:relative;display:grid;grid-template-columns:minmax(14rem,.85fr) minmax(18rem,1fr);width:min(56rem,100%);overflow:hidden;border-radius:1.4rem;background:#fff;box-shadow:0 30px 80px rgba(2,6,23,.35)}
      .shamel-popup__image{min-height:30rem;background:#eef2f7 center/cover no-repeat}.shamel-popup__content{display:flex;flex-direction:column;justify-content:center;padding:2.4rem}
      .shamel-popup__close{position:absolute;top:.8rem;right:.8rem;z-index:2;width:2.4rem;height:2.4rem;border:0;border-radius:50%;background:rgba(255,255,255,.9);color:#0f172a;font-size:1.35rem;cursor:pointer}
      .shamel-popup__eyebrow{color:#b45309;font-weight:800}.shamel-popup h2{margin:.65rem 0;font-size:2rem;line-height:1.3;font-weight:900;color:#0f172a}.shamel-popup p{color:#64748b;line-height:1.8}
      .shamel-popup form{display:grid;gap:.75rem;margin-top:1rem}.shamel-popup input{min-height:3.2rem;padding:.8rem 1rem;border:1px solid #cbd5e1;border-radius:.8rem}.shamel-popup button[type=submit]{min-height:3.2rem;border:0;border-radius:.8rem;background:#0f4c6b;color:#fff;font-weight:800;cursor:pointer}.shamel-popup__privacy{font-size:.72rem;color:#94a3b8}
      @media(max-width:640px){.shamel-follow__inner{align-items:flex-start;flex-direction:column}.shamel-popup__card{display:block;max-height:92vh;overflow:auto}.shamel-popup__image{min-height:13rem}.shamel-popup__content{padding:1.5rem}.shamel-popup h2{font-size:1.55rem}}
      @media(prefers-reduced-motion:reduce){.shamel-news__track,.shamel-contact__link--whatsapp,.shamel-contact__link--whatsapp:before,.shamel-contact__link--whatsapp:after{animation:none}}
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
{% set shamel_store_mode_raw = theme.settings.get('shamel_store_mode', 'general') %}
{% set shamel_ui_style_raw = theme.settings.get('shamel_ui_style', 'modern') %}
{% set shamel_header_layout_raw = theme.settings.get('shamel_header_layout', 'classic') %}
{% set shamel_surface_radius_raw = theme.settings.get('shamel_surface_radius', 'soft') %}
{% set shamel_product_density_raw = theme.settings.get('shamel_product_density', 'comfortable') %}
{% set shamel_announcement_speed_raw = theme.settings.get('shamel_announcement_speed', 'normal') %}
{% set shamel_popup_capture_raw = theme.settings.get('shamel_popup_capture_type', 'email') %}
{% set shamel_store_mode = shamel_store_mode_raw is iterable ? (shamel_store_mode_raw|first).value : shamel_store_mode_raw %}
{% set shamel_ui_style = shamel_ui_style_raw is iterable ? (shamel_ui_style_raw|first).value : shamel_ui_style_raw %}
{% set shamel_header_layout = shamel_header_layout_raw is iterable ? (shamel_header_layout_raw|first).value : shamel_header_layout_raw %}
{% set shamel_surface_radius = shamel_surface_radius_raw is iterable ? (shamel_surface_radius_raw|first).value : shamel_surface_radius_raw %}
{% set shamel_product_density = shamel_product_density_raw is iterable ? (shamel_product_density_raw|first).value : shamel_product_density_raw %}
{% set shamel_announcement_speed = shamel_announcement_speed_raw is iterable ? (shamel_announcement_speed_raw|first).value : shamel_announcement_speed_raw %}
{% set shamel_popup_capture = shamel_popup_capture_raw is iterable ? (shamel_popup_capture_raw|first).value : shamel_popup_capture_raw %}
<body id="app" class="theme-raed shamel-pro shamel-mode-{{ shamel_store_mode }} shamel-style-{{ shamel_ui_style }} shamel-header-{{ shamel_header_layout }} shamel-radius-{{ shamel_surface_radius }} shamel-density-{{ shamel_product_density }}{{ theme.settings.get('shamel_motion_enabled', true) ? ' shamel-motion' : '' }} overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  ">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
{% if theme.settings.get('shamel_announcement_enabled', true) and theme.settings.get('shamel_announcement_text') %}
  <aside class="shamel-news shamel-news--{{ shamel_announcement_speed }}" aria-label="إعلانات المتجر">
    <div class="shamel-news__track">
      <span>{{ theme.settings.get('shamel_announcement_text')|replace({'|':' ✦ '}) }}</span>
      <span aria-hidden="true">{{ theme.settings.get('shamel_announcement_text')|replace({'|':' ✦ '}) }}</span>
      <span aria-hidden="true">{{ theme.settings.get('shamel_announcement_text')|replace({'|':' ✦ '}) }}</span>
    </div>
  </aside>
{% endif %}
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% if theme.settings.get('shamel_follow_enabled', true) %}
      <section class="shamel-follow" aria-labelledby="shamel-follow-title">
        <div class="container shamel-follow__inner">
          <div>
            <h2 id="shamel-follow-title">{{ theme.settings.get('shamel_follow_title', 'تابعنا وكن أول من يعرف') }}</h2>
            <p>{{ theme.settings.get('shamel_follow_description', 'اكتشف جديدنا وعروضنا الحصرية عبر منصات التواصل.') }}</p>
          </div>
          <nav class="shamel-follow__links" aria-label="تابع المتجر">
            {% if theme.settings.get('shamel_instagram_enabled') and theme.settings.get('shamel_instagram_url') %}<a href="{{ theme.settings.get('shamel_instagram_url') }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="sicon-instagram"></i></a>{% endif %}
            {% if theme.settings.get('shamel_tiktok_enabled') and theme.settings.get('shamel_tiktok_url') %}<a href="{{ theme.settings.get('shamel_tiktok_url') }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><span>♪</span></a>{% endif %}
            {% if theme.settings.get('shamel_snapchat_enabled') and theme.settings.get('shamel_snapchat_url') %}<a href="{{ theme.settings.get('shamel_snapchat_url') }}" target="_blank" rel="noopener noreferrer" aria-label="Snapchat"><i class="sicon-snapchat"></i></a>{% endif %}
            {% if theme.settings.get('shamel_x_enabled') and theme.settings.get('shamel_x_url') %}<a href="{{ theme.settings.get('shamel_x_url') }}" target="_blank" rel="noopener noreferrer" aria-label="X"><span>X</span></a>{% endif %}
            {% if theme.settings.get('shamel_youtube_enabled') and theme.settings.get('shamel_youtube_url') %}<a href="{{ theme.settings.get('shamel_youtube_url') }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="sicon-youtube"></i></a>{% endif %}
            {% if theme.settings.get('shamel_facebook_enabled') and theme.settings.get('shamel_facebook_url') %}<a href="{{ theme.settings.get('shamel_facebook_url') }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="sicon-facebook"></i></a>{% endif %}
          </nav>
        </div>
      </section>
    {% endif %}
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}

{# Shamel Pro: merchant-controlled floating contact hub #}
{% if theme.settings.get('shamel_social_enabled', true) %}
  {% set shamel_whatsapp = theme.settings.get('shamel_whatsapp_number') %}
  {% set shamel_position_raw = theme.settings.get('shamel_social_position', 'right') %}
  {% set shamel_position = shamel_position_raw is iterable ? (shamel_position_raw|first).value : shamel_position_raw %}
  <div class="shamel-contact shamel-contact--{{ shamel_position }}" data-testid="shamel-contact">
    <div class="shamel-contact__details">
      <span class="shamel-contact__promo">{{ theme.settings.get('shamel_contact_promo', 'سؤال سريع؟ نحن هنا لمساعدتك') }}</span>
      <nav class="shamel-contact__menu" aria-label="وسائل التواصل">
        {% if theme.settings.get('shamel_whatsapp_enabled', true) and shamel_whatsapp %}
          <a class="shamel-contact__link shamel-contact__link--whatsapp" href="https://wa.me/{{ shamel_whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="واتساب">
            <i class="sicon-whatsapp" aria-hidden="true"></i><span>واتساب</span>
          </a>
        {% endif %}
        {% if theme.settings.get('shamel_instagram_enabled') and theme.settings.get('shamel_instagram_url') %}
          <a class="shamel-contact__link" href="{{ theme.settings.get('shamel_instagram_url') }}" target="_blank" rel="noopener noreferrer"><i class="sicon-instagram" aria-hidden="true"></i><span>Instagram</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_tiktok_enabled') and theme.settings.get('shamel_tiktok_url') %}
          <a class="shamel-contact__link" href="{{ theme.settings.get('shamel_tiktok_url') }}" target="_blank" rel="noopener noreferrer"><span class="shamel-contact__glyph">♪</span><span>TikTok</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_snapchat_enabled') and theme.settings.get('shamel_snapchat_url') %}
          <a class="shamel-contact__link" href="{{ theme.settings.get('shamel_snapchat_url') }}" target="_blank" rel="noopener noreferrer"><i class="sicon-snapchat" aria-hidden="true"></i><span>Snapchat</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_x_enabled') and theme.settings.get('shamel_x_url') %}
          <a class="shamel-contact__link" href="{{ theme.settings.get('shamel_x_url') }}" target="_blank" rel="noopener noreferrer"><span class="shamel-contact__glyph">X</span><span>X</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_youtube_enabled') and theme.settings.get('shamel_youtube_url') %}
          <a class="shamel-contact__link" href="{{ theme.settings.get('shamel_youtube_url') }}" target="_blank" rel="noopener noreferrer"><i class="sicon-youtube" aria-hidden="true"></i><span>YouTube</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_facebook_enabled') and theme.settings.get('shamel_facebook_url') %}
          <a class="shamel-contact__link" href="{{ theme.settings.get('shamel_facebook_url') }}" target="_blank" rel="noopener noreferrer"><i class="sicon-facebook" aria-hidden="true"></i><span>Facebook</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_email_enabled') and theme.settings.get('shamel_email') %}
          <a class="shamel-contact__link" href="mailto:{{ theme.settings.get('shamel_email') }}"><i class="sicon-mail" aria-hidden="true"></i><span>البريد</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_phone_enabled') and theme.settings.get('shamel_phone') %}
          <a class="shamel-contact__link" href="tel:{{ theme.settings.get('shamel_phone') }}"><i class="sicon-phone" aria-hidden="true"></i><span>اتصال</span></a>
        {% endif %}
      </nav>
    </div>
  </div>
  <style>
    .shamel-contact{position:fixed;bottom:max(1rem,env(safe-area-inset-bottom));z-index:90;font-family:var(--font-main)}
    .shamel-contact--right{right:1rem}.shamel-contact--left{left:1rem}
    .shamel-contact__details{display:flex;align-items:center;gap:.7rem;filter:drop-shadow(0 12px 24px rgba(15,23,42,.14))}
    .shamel-contact--left .shamel-contact__details{flex-direction:row-reverse}
    .shamel-contact__promo{position:relative;max-width:15rem;padding:.72rem 1rem;border:1px solid rgba(148,163,184,.22);border-radius:1rem;background:#fff;color:#0f172a;font-size:.86rem;font-weight:700;line-height:1.45;box-shadow:0 10px 28px rgba(15,23,42,.12)}
    .shamel-contact--right .shamel-contact__promo:after{content:"";position:absolute;right:-.38rem;top:50%;width:.72rem;height:.72rem;background:#fff;border-top:1px solid rgba(148,163,184,.22);border-right:1px solid rgba(148,163,184,.22);transform:translateY(-50%) rotate(45deg)}
    .shamel-contact--left .shamel-contact__promo:after{content:"";position:absolute;left:-.38rem;top:50%;width:.72rem;height:.72rem;background:#fff;border-bottom:1px solid rgba(148,163,184,.22);border-left:1px solid rgba(148,163,184,.22);transform:translateY(-50%) rotate(45deg)}
    .shamel-contact__menu{display:flex;align-items:center;flex-wrap:wrap;justify-content:flex-end;gap:.5rem;max-width:13rem}
    .shamel-contact--left .shamel-contact__menu{justify-content:flex-start}
    .shamel-contact__link{position:relative;display:grid;place-items:center;width:3.35rem;height:3.35rem;padding:0;border:3px solid rgba(255,255,255,.95);border-radius:50%;background:#0f4c6b;color:#fff;text-decoration:none;box-shadow:0 10px 26px rgba(15,76,107,.28);transition:transform .18s ease,box-shadow .18s ease,background .18s ease}
    .shamel-contact__link:hover{background:#123f59;transform:translateY(-3px) scale(1.04);box-shadow:0 14px 30px rgba(15,76,107,.34)}
    .shamel-contact__link i,.shamel-contact__glyph{width:auto;text-align:center;font-size:1.45rem;color:inherit}
    .shamel-contact__link--whatsapp{isolation:isolate;width:3.8rem;height:3.8rem;background:linear-gradient(145deg,#39e56f,#16a34a);box-shadow:0 12px 30px rgba(34,197,94,.42),inset 0 1px 0 rgba(255,255,255,.45);animation:shamel-whatsapp-float 2.7s ease-in-out infinite}
    .shamel-contact__link--whatsapp:before{content:"";position:absolute;z-index:-1;inset:-.42rem;border:2px solid rgba(34,197,94,.38);border-radius:50%;animation:shamel-whatsapp-pulse 2.2s ease-out infinite}
    .shamel-contact__link--whatsapp:after{content:"";position:absolute;inset:3px;border-radius:50%;background:linear-gradient(120deg,transparent 22%,rgba(255,255,255,.55) 42%,transparent 61%);transform:translateX(-120%);animation:shamel-whatsapp-shine 3.2s ease-in-out infinite;pointer-events:none}
    .shamel-contact__link--whatsapp i{font-size:1.75rem;text-shadow:0 2px 5px rgba(0,0,0,.14)}
    .shamel-contact__link--whatsapp:hover{background:linear-gradient(145deg,#4ade80,#15803d);transform:translateY(-4px) scale(1.06)}
    @keyframes shamel-whatsapp-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
    @keyframes shamel-whatsapp-pulse{0%{opacity:.75;transform:scale(.9)}70%,100%{opacity:0;transform:scale(1.28)}}
    @keyframes shamel-whatsapp-shine{0%,35%{transform:translateX(-120%)}65%,100%{transform:translateX(120%)}}
    .shamel-contact__link>span:last-child:not(.shamel-contact__glyph){position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:480px){.shamel-contact{bottom:max(.75rem,env(safe-area-inset-bottom))}.shamel-contact--right{right:.75rem}.shamel-contact--left{left:.75rem}.shamel-contact__details{gap:.5rem}.shamel-contact__promo{max-width:10.5rem;padding:.58rem .72rem;font-size:.75rem}.shamel-contact__menu{max-width:7.2rem;gap:.35rem}.shamel-contact__link{width:3.1rem;height:3.1rem}.shamel-contact__link i,.shamel-contact__glyph{font-size:1.3rem}}
  </style>
{% endif %}

{% if theme.settings.get('shamel_popup_enabled') and theme.settings.get('shamel_popup_action_url') %}
  <div id="shamel-marketing-popup" class="shamel-popup" hidden role="dialog" aria-modal="true" aria-labelledby="shamel-popup-title">
    <div class="shamel-popup__card">
      <button type="button" class="shamel-popup__close" aria-label="إغلاق">×</button>
      <div class="shamel-popup__image"{% if theme.settings.get('shamel_popup_image') %} style="background-image:url('{{ theme.settings.get('shamel_popup_image') }}')"{% endif %}></div>
      <div class="shamel-popup__content">
        <span class="shamel-popup__eyebrow">{{ theme.settings.get('shamel_popup_eyebrow', 'خصم خاص') }}</span>
        <h2 id="shamel-popup-title">{{ theme.settings.get('shamel_popup_title', 'احصل على خصم على أول طلب لك') }}</h2>
        <p>{{ theme.settings.get('shamel_popup_description', 'سجّل بياناتك لتصلك أحدث العروض والإصدارات.') }}</p>
        <form action="{{ theme.settings.get('shamel_popup_action_url') }}" method="post" target="shamel-popup-target">
          {% if shamel_popup_capture == 'phone' %}
            <input type="tel" name="phone" autocomplete="tel" required placeholder="أدخل رقم الجوال">
          {% else %}
            <input type="email" name="email" autocomplete="email" required placeholder="أدخل بريدك الإلكتروني">
          {% endif %}
          <button type="submit">{{ theme.settings.get('shamel_popup_button', 'احصل على العرض') }}</button>
          <small class="shamel-popup__privacy">بالتسجيل أنت توافق على استلام الرسائل التسويقية، ويمكنك إلغاء الاشتراك لاحقًا.</small>
        </form>
        <iframe name="shamel-popup-target" title="استقبال التسجيل" hidden></iframe>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var popup = document.getElementById('shamel-marketing-popup');
      if (!popup) return;
      var key = 'shamel_popup_hidden_until';
      var hiddenUntil = Number(localStorage.getItem(key) || 0);
      if (Date.now() < hiddenUntil) return;
      window.setTimeout(function(){ popup.hidden = false; }, 1600);
      function closePopup(){ popup.hidden = true; localStorage.setItem(key, String(Date.now() + 604800000)); }
      popup.querySelector('.shamel-popup__close').addEventListener('click', closePopup);
      popup.addEventListener('click', function(e){ if(e.target === popup) closePopup(); });
      popup.querySelector('form').addEventListener('submit', function(){ window.setTimeout(closePopup, 250); });
    });
  </script>
{% endif %}
</body>
</html>
