{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = {{ theme.settings.get('header_is_sticky', true) ? 'true' : 'false' }}
        window.imageZoom = {{ theme.settings.get('imageZoom', false) ? 'true' : 'false' }}
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = {{ theme.settings.get('enable_more_menu', true) ? 'true' : 'false' }}
        window.enable_add_product_toast = {{ theme.settings.get('enable_add_product_toast', true) ? 'true' : 'false' }}
        window.notify_when_available_in_card = {{ theme.settings.get('notify_when_available_in_card', true) ? 'true' : 'false' }}
        window.shamel_card_discount_badge = {{ theme.settings.get('shamel_card_discount_badge', true) ? 'true' : 'false' }}
        window.shamel_card_type_badge = {{ theme.settings.get('shamel_card_type_badge', true) ? 'true' : 'false' }}
        window.shamel_compare_enabled = {{ theme.settings.get('shamel_compare_enabled', true) ? 'true' : 'false' }}
        window.shamel_wishlist_enabled = {{ theme.settings.get('shamel_side_wishlist_enabled', true) ? 'true' : 'false' }}
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            /* Theme specific variables */
            --s-radius: .75rem;
        }
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
{% set shamel_store_mode_raw = theme.settings.get('shamel_store_mode', 'general') %}
{% set shamel_industry_raw = theme.settings.get('shamel_industry_preset', 'universal') %}
{% set shamel_ui_style_raw = theme.settings.get('shamel_ui_style', 'modern') %}
{% set shamel_header_layout_raw = theme.settings.get('shamel_header_layout', 'classic') %}
{% set shamel_surface_radius_raw = theme.settings.get('shamel_surface_radius', 'soft') %}
{% set shamel_product_density_raw = theme.settings.get('shamel_product_density', 'comfortable') %}
{% set shamel_announcement_speed_raw = theme.settings.get('shamel_announcement_speed', 'normal') %}
{% set shamel_popup_capture_raw = theme.settings.get('shamel_popup_capture_type', 'email') %}
{% set shamel_store_mode = shamel_store_mode_raw is iterable ? (shamel_store_mode_raw|first).value : shamel_store_mode_raw %}
{% set shamel_industry = shamel_industry_raw is iterable ? (shamel_industry_raw|first).value : shamel_industry_raw %}
{% set shamel_ui_style = shamel_ui_style_raw is iterable ? (shamel_ui_style_raw|first).value : shamel_ui_style_raw %}
{% set shamel_header_layout = shamel_header_layout_raw is iterable ? (shamel_header_layout_raw|first).value : shamel_header_layout_raw %}
{% set shamel_surface_radius = shamel_surface_radius_raw is iterable ? (shamel_surface_radius_raw|first).value : shamel_surface_radius_raw %}
{% set shamel_product_density = shamel_product_density_raw is iterable ? (shamel_product_density_raw|first).value : shamel_product_density_raw %}
{% set shamel_announcement_speed = shamel_announcement_speed_raw is iterable ? (shamel_announcement_speed_raw|first).value : shamel_announcement_speed_raw %}
{% set shamel_popup_capture = shamel_popup_capture_raw is iterable ? (shamel_popup_capture_raw|first).value : shamel_popup_capture_raw %}
<body id="app" class="theme-raed shamel-pro shamel-mode-{{ shamel_store_mode }} shamel-industry-{{ shamel_industry }} shamel-style-{{ shamel_ui_style }} shamel-header-{{ shamel_header_layout }} shamel-radius-{{ shamel_surface_radius }} shamel-density-{{ shamel_product_density }}{{ theme.settings.get('shamel_motion_enabled', true) ? ' shamel-motion' : '' }} overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  " style="--sp-primary:{{ theme.settings.get('shamel_color_primary', '#0f4c6b') }};--sp-button-text:{{ theme.settings.get('shamel_color_button_text', '#ffffff') }};--sp-page-bg:{{ theme.settings.get('shamel_color_page_bg', '#ffffff') }};--sp-text:{{ theme.settings.get('shamel_color_text', '#334155') }};--sp-heading:{{ theme.settings.get('shamel_color_heading', '#0f172a') }};--sp-card-bg:{{ theme.settings.get('shamel_color_card_bg', '#ffffff') }};--sp-section-bg:{{ theme.settings.get('shamel_color_section_bg', '#ffffff') }};--sp-section-alt-bg:{{ theme.settings.get('shamel_color_section_alt_bg', '#f8fafc') }};--sp-header-bg:{{ theme.settings.get('shamel_color_header_bg', '#ffffff') }};--sp-categories-bg:{{ theme.settings.get('shamel_color_categories_bg', '#f8fafc') }};--sp-categories-dark-bg:{{ theme.settings.get('shamel_color_header_dark_bg', '#0b1120') }};--sp-header-text:{{ theme.settings.get('shamel_color_header_text', '#0f172a') }};--sp-news-bg:{{ theme.settings.get('shamel_color_news_bg', '#071a2f') }};--sp-news-text:{{ theme.settings.get('shamel_color_news_text', '#ffffff') }};--sp-footer-bg:{{ theme.settings.get('shamel_color_footer_bg', '#0f172a') }};--sp-footer-text:{{ theme.settings.get('shamel_color_footer_text', '#ffffff') }};--sp-popup-bg:{{ theme.settings.get('shamel_color_popup_bg', '#ffffff') }};--sp-popup-text:{{ theme.settings.get('shamel_color_popup_text', '#0f172a') }};--sp-social-bg:{{ theme.settings.get('shamel_color_social_bg', '#0f4c6b') }};--sp-social-icon:{{ theme.settings.get('shamel_color_social_icon', '#ffffff') }};--sp-whatsapp:{{ theme.settings.get('shamel_color_whatsapp', '#22c55e') }};--color-primary:var(--sp-primary);--color-primary-reverse:var(--sp-button-text)">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% if theme.settings.get('shamel_follow_enabled', true) %}
      <section class="shamel-follow" aria-labelledby="shamel-follow-title" style="--shamel-follow-bg:{{ theme.settings.get('shamel_follow_bg_color', '#071a2f') }};--shamel-follow-text:{{ theme.settings.get('shamel_follow_text_color', '#ffffff') }};--shamel-follow-icon:{{ theme.settings.get('shamel_follow_icon_color', '#ffffff') }}">
        <div class="container shamel-follow__inner">
          <div>
            <h2 id="shamel-follow-title">{{ theme.settings.get('shamel_follow_title', 'تابعنا وكن أول من يعرف') }}</h2>
            <p>{{ theme.settings.get('shamel_follow_description', 'اكتشف جديدنا وعروضنا الحصرية عبر منصات التواصل.') }}</p>
          </div>
          <nav class="shamel-follow__links" aria-label="تابع المتجر">
            {% if theme.settings.get('shamel_follow_whatsapp_enabled') and theme.settings.get('shamel_follow_whatsapp_url') %}<a href="{{ theme.settings.get('shamel_follow_whatsapp_url') }}" target="_blank" rel="noopener noreferrer" class="shamel-social--whatsapp" aria-label="قناة واتساب"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a9.8 9.8 0 0 0-8.5 14.7L2 22l5.4-1.4A10 10 0 1 0 12 2Zm0 17.9a8 8 0 0 1-4.1-1.1l-.3-.2-3.2.8.9-3.1-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-1.4-.7-2.4-1.3-3.3-2.9-.2-.3.2-.4.6-.9.1-.2.1-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.2 1.8.8 2.5.8 3.4.7 1-.2 1.4-.9 1.6-1.8.2-.8.2-1.5.1-1.7-.2-.2-.4-.2-.7-.3Z"/></svg></a>{% endif %}
            {% if theme.settings.get('shamel_follow_instagram_enabled') and theme.settings.get('shamel_follow_instagram_url') %}<a href="{{ theme.settings.get('shamel_follow_instagram_url') }}" target="_blank" rel="noopener noreferrer" class="shamel-social--instagram" aria-label="Instagram"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.4 2h9.2A5.4 5.4 0 0 1 22 7.4v9.2a5.4 5.4 0 0 1-5.4 5.4H7.4A5.4 5.4 0 0 1 2 16.6V7.4A5.4 5.4 0 0 1 7.4 2Zm-.2 2A3.2 3.2 0 0 0 4 7.2v9.6A3.2 3.2 0 0 0 7.2 20h9.6a3.2 3.2 0 0 0 3.2-3.2V7.2A3.2 3.2 0 0 0 16.8 4H7.2Zm10.3 1.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg></a>{% endif %}
            {% if theme.settings.get('shamel_follow_tiktok_enabled') and theme.settings.get('shamel_follow_tiktok_url') %}<a href="{{ theme.settings.get('shamel_follow_tiktok_url') }}" target="_blank" rel="noopener noreferrer" class="shamel-social--tiktok" aria-label="TikTok"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.6 3c.4 2.3 1.8 3.8 4.1 4.2v3.2c-1.5 0-2.9-.5-4.1-1.3v6.1a6.2 6.2 0 1 1-5.4-6.1v3.3a3 3 0 1 0 2.2 2.9V3h3.2Z"/></svg></a>{% endif %}
            {% if theme.settings.get('shamel_follow_snapchat_enabled') and theme.settings.get('shamel_follow_snapchat_url') %}<a href="{{ theme.settings.get('shamel_follow_snapchat_url') }}" target="_blank" rel="noopener noreferrer" class="shamel-social--snapchat" aria-label="Snapchat"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c3.1 0 5.1 2.4 5.1 5.5 0 1.2-.2 2.2.2 2.5.5.4 1.5-.1 1.9.7.3.7-.6 1.2-1.6 1.6-.5.2-.6.5-.4.9.6 1.3 1.7 2.1 3.2 2.7.5.2.4 1-.1 1.1-.7.2-1.4.2-1.8.5-.5.4-.3 1.3-1.1 1.4-.5.1-1.1-.3-2.1.1-1 .4-1.7 1-3.3 1s-2.3-.6-3.3-1c-1-.4-1.6 0-2.1-.1-.8-.1-.6-1-1.1-1.4-.4-.3-1.1-.3-1.8-.5-.5-.1-.6-.9-.1-1.1 1.5-.6 2.6-1.4 3.2-2.7.2-.4.1-.7-.4-.9-1-.4-1.9-.9-1.6-1.6.4-.8 1.4-.3 1.9-.7.4-.3.2-1.3.2-2.5C6.9 4.4 8.9 2 12 2Z"/></svg></a>{% endif %}
            {% if theme.settings.get('shamel_follow_x_enabled') and theme.settings.get('shamel_follow_x_url') %}<a href="{{ theme.settings.get('shamel_follow_x_url') }}" target="_blank" rel="noopener noreferrer" class="shamel-social--x" aria-label="X"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23.2 22H17l-4.9-6.4L6.5 22H3.3l7.3-8.4L2.8 2H9l4.4 5.8L18.9 2Zm-1.1 17.8h1.7L8 4.1H6.2l11.6 15.7Z"/></svg></a>{% endif %}
            {% if theme.settings.get('shamel_follow_youtube_enabled') and theme.settings.get('shamel_follow_youtube_url') %}<a href="{{ theme.settings.get('shamel_follow_youtube_url') }}" target="_blank" rel="noopener noreferrer" class="shamel-social--youtube" aria-label="YouTube"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg></a>{% endif %}
            {% if theme.settings.get('shamel_follow_facebook_enabled') and theme.settings.get('shamel_follow_facebook_url') %}<a href="{{ theme.settings.get('shamel_follow_facebook_url') }}" target="_blank" rel="noopener noreferrer" class="shamel-social--facebook" aria-label="Facebook"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 8.5V6.8c0-.8.5-1 1-1h2.8V2.2L15.1 2C11.8 2 10 4 10 6.4v2.1H7v4h3V22h4v-9.5h3.3l.5-4H14Z"/></svg></a>{% endif %}
          </nav>
        </div>
      </section>
    {% endif %}
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}

{# Shamel Pro: merchant-controlled floating contact hub #}
{% if theme.settings.get('shamel_social_enabled', true) %}
  {% set shamel_whatsapp = theme.settings.get('shamel_whatsapp_number') %}
  {% set shamel_position_raw = theme.settings.get('shamel_social_position', 'right') %}
  {% set shamel_position = shamel_position_raw is iterable ? (shamel_position_raw|first).value : shamel_position_raw %}
  <div class="shamel-contact shamel-contact--{{ shamel_position }}" data-testid="shamel-contact">
    <div class="shamel-contact__details">
      {% set shamel_contact_promo = theme.settings.get('shamel_contact_promo') %}{% if shamel_contact_promo|trim %}<span class="shamel-contact__promo">{{ shamel_contact_promo }}</span>{% endif %}
      <nav class="shamel-contact__menu" aria-label="وسائل التواصل">
        {% if theme.settings.get('shamel_whatsapp_enabled', true) and shamel_whatsapp %}
          <a class="shamel-contact__link shamel-contact__link--whatsapp shamel-social--whatsapp" href="https://wa.me/{{ shamel_whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="واتساب">
            <svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a9.8 9.8 0 0 0-8.5 14.7L2 22l5.4-1.4A10 10 0 1 0 12 2Zm0 17.9a8 8 0 0 1-4.1-1.1l-.3-.2-3.2.8.9-3.1-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-1.4-.7-2.4-1.3-3.3-2.9-.2-.3.2-.4.6-.9.1-.2.1-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.2 1.8.8 2.5.8 3.4.7 1-.2 1.4-.9 1.6-1.8.2-.8.2-1.5.1-1.7-.2-.2-.4-.2-.7-.3Z"/></svg><span>واتساب</span>
          </a>
        {% endif %}
        {% if theme.settings.get('shamel_instagram_enabled') and theme.settings.get('shamel_instagram_url') %}
          <a class="shamel-contact__link shamel-social--instagram" href="{{ theme.settings.get('shamel_instagram_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.4 2h9.2A5.4 5.4 0 0 1 22 7.4v9.2a5.4 5.4 0 0 1-5.4 5.4H7.4A5.4 5.4 0 0 1 2 16.6V7.4A5.4 5.4 0 0 1 7.4 2Zm-.2 2A3.2 3.2 0 0 0 4 7.2v9.6A3.2 3.2 0 0 0 7.2 20h9.6a3.2 3.2 0 0 0 3.2-3.2V7.2A3.2 3.2 0 0 0 16.8 4H7.2Zm10.3 1.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg><span>Instagram</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_tiktok_enabled') and theme.settings.get('shamel_tiktok_url') %}
          <a class="shamel-contact__link shamel-social--tiktok" href="{{ theme.settings.get('shamel_tiktok_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.6 3c.4 2.3 1.8 3.8 4.1 4.2v3.2c-1.5 0-2.9-.5-4.1-1.3v6.1a6.2 6.2 0 1 1-5.4-6.1v3.3a3 3 0 1 0 2.2 2.9V3h3.2Z"/></svg><span>TikTok</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_snapchat_enabled') and theme.settings.get('shamel_snapchat_url') %}
          <a class="shamel-contact__link shamel-social--snapchat" href="{{ theme.settings.get('shamel_snapchat_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c3.1 0 5.1 2.4 5.1 5.5 0 1.2-.2 2.2.2 2.5.5.4 1.5-.1 1.9.7.3.7-.6 1.2-1.6 1.6-.5.2-.6.5-.4.9.6 1.3 1.7 2.1 3.2 2.7.5.2.4 1-.1 1.1-.7.2-1.4.2-1.8.5-.5.4-.3 1.3-1.1 1.4-.5.1-1.1-.3-2.1.1-1 .4-1.7 1-3.3 1s-2.3-.6-3.3-1c-1-.4-1.6 0-2.1-.1-.8-.1-.6-1-1.1-1.4-.4-.3-1.1-.3-1.8-.5-.5-.1-.6-.9-.1-1.1 1.5-.6 2.6-1.4 3.2-2.7.2-.4.1-.7-.4-.9-1-.4-1.9-.9-1.6-1.6.4-.8 1.4-.3 1.9-.7.4-.3.2-1.3.2-2.5C6.9 4.4 8.9 2 12 2Z"/></svg><span>Snapchat</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_x_enabled') and theme.settings.get('shamel_x_url') %}
          <a class="shamel-contact__link shamel-social--x" href="{{ theme.settings.get('shamel_x_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23.2 22H17l-4.9-6.4L6.5 22H3.3l7.3-8.4L2.8 2H9l4.4 5.8L18.9 2Zm-1.1 17.8h1.7L8 4.1H6.2l11.6 15.7Z"/></svg><span>X</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_youtube_enabled') and theme.settings.get('shamel_youtube_url') %}
          <a class="shamel-contact__link shamel-social--youtube" href="{{ theme.settings.get('shamel_youtube_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg><span>YouTube</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_facebook_enabled') and theme.settings.get('shamel_facebook_url') %}
          <a class="shamel-contact__link shamel-social--facebook" href="{{ theme.settings.get('shamel_facebook_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 8.5V6.8c0-.8.5-1 1-1h2.8V2.2L15.1 2C11.8 2 10 4 10 6.4v2.1H7v4h3V22h4v-9.5h3.3l.5-4H14Z"/></svg><span>Facebook</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_email_enabled') and theme.settings.get('shamel_email') %}
          <a class="shamel-contact__link" href="mailto:{{ theme.settings.get('shamel_email') }}"><i class="sicon-mail" aria-hidden="true"></i><span>البريد</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_phone_enabled') and theme.settings.get('shamel_phone') %}
          <a class="shamel-contact__link" href="tel:{{ theme.settings.get('shamel_phone') }}"><i class="sicon-phone" aria-hidden="true"></i><span>اتصال</span></a>
        {% endif %}
      </nav>
    </div>
  </div>
{% endif %}


{% if theme.settings.get('shamel_side_tools_enabled', true) %}
  {% set shamel_tools_position_raw = theme.settings.get('shamel_side_tools_position_v2', 'left') %}
  {% set shamel_tools_position = shamel_tools_position_raw is iterable ? (shamel_tools_position_raw|first).value : shamel_tools_position_raw %}
  <nav class="shamel-side-tools shamel-side-tools--{{ shamel_tools_position }}" aria-label="أدوات المتجر" data-shamel-side-tools>
    {% if theme.settings.get('shamel_side_newsletter_enabled', true) %}
      <button type="button" data-shamel-newsletter-open title="اشترك في نشرتنا البريدية"><i class="sicon-mail" aria-hidden="true"></i><span class="shamel-side-tools__label">اشترك في نشرتنا</span></button>
    {% endif %}
    <button type="button" data-shamel-tools-close aria-label="طي شريط الأدوات" title="طي الأدوات">×</button>
    <button type="button" data-shamel-tools-open aria-label="فتح شريط الأدوات" title="فتح الأدوات"><span class="shamel-side-tools__open-left">›</span><span class="shamel-side-tools__open-right">‹</span></button>
  </nav>
  {% if theme.settings.get('shamel_side_newsletter_enabled', true) %}
    <section class="shamel-newsletter-drawer" data-shamel-newsletter-drawer hidden role="dialog" aria-modal="true" aria-labelledby="shamel-newsletter-title" tabindex="-1">
      <div class="shamel-newsletter-drawer__card">
        <button type="button" class="shamel-newsletter-drawer__close" data-shamel-newsletter-close aria-label="إغلاق">×</button>
        <h2 id="shamel-newsletter-title">اشترك في نشرتنا البريدية</h2>
        <p>كن أول من يعرف بالعروض والمنتجات الجديدة.</p>
        <form class="shamel-newsletter-drawer__form" data-shamel-newsletter-form{% if theme.settings.get('shamel_popup_action_url') %} action="{{ theme.settings.get('shamel_popup_action_url') }}" method="post"{% endif %}>
          <input type="email" name="email" autocomplete="email" required placeholder="أدخل بريدك الإلكتروني" aria-label="البريد الإلكتروني">
          <button type="submit">اشترك الآن</button>
        </form>
      </div>
    </section>
  {% endif %}
  {% if theme.settings.get('shamel_compare_enabled', true) %}
    <section class="shamel-compare-drawer" data-shamel-compare-drawer hidden role="dialog" aria-modal="true" aria-labelledby="shamel-compare-title" tabindex="-1">
      <header class="shamel-compare-drawer__head"><h2 id="shamel-compare-title">مقارنة المنتجات</h2><button type="button" class="shamel-compare-drawer__close" data-shamel-compare-close aria-label="إغلاق">×</button></header>
      <div class="shamel-compare-drawer__items" data-shamel-compare-items></div>
    </section>
  {% endif %}
{% endif %}

{% if theme.settings.get('shamel_popup_enabled') and theme.settings.get('shamel_popup_action_url') %}
  <div id="shamel-marketing-popup" class="shamel-popup" hidden role="dialog" aria-modal="true" aria-labelledby="shamel-popup-title" tabindex="-1">
    <div class="shamel-popup__card">
      <button type="button" class="shamel-popup__close" aria-label="إغلاق">×</button>
      <div class="shamel-popup__image"{% if theme.settings.get('shamel_popup_image') %} style="background-image:url('{{ theme.settings.get('shamel_popup_image') }}')"{% endif %}></div>
      <div class="shamel-popup__content">
        <span class="shamel-popup__eyebrow">{{ theme.settings.get('shamel_popup_eyebrow', 'خصم خاص') }}</span>
        <h2 id="shamel-popup-title">{{ theme.settings.get('shamel_popup_title', 'احصل على خصم على أول طلب لك') }}</h2>
        <p>{{ theme.settings.get('shamel_popup_description', 'سجّل بياناتك لتصلك أحدث العروض والإصدارات.') }}</p>
        <form action="{{ theme.settings.get('shamel_popup_action_url') }}" method="post" target="shamel-popup-target">
          {% if shamel_popup_capture == 'phone' %}
            <input type="tel" name="phone" autocomplete="tel" required placeholder="أدخل رقم الجوال">
          {% else %}
            <input type="email" name="email" autocomplete="email" required placeholder="أدخل بريدك الإلكتروني">
          {% endif %}
          <button type="submit">{{ theme.settings.get('shamel_popup_button', 'احصل على العرض') }}</button>
          <small class="shamel-popup__privacy">بالتسجيل أنت توافق على استلام الرسائل التسويقية، ويمكنك إلغاء الاشتراك لاحقًا.</small>
        </form>
        <iframe name="shamel-popup-target" title="استقبال التسجيل" hidden></iframe>
      </div>
    </div>
  </div>
{% endif %}
</body>
</html>
