{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
        window.shamel_card_discount_badge = {{ theme.settings.get('shamel_card_discount_badge', true) ? 'true' : 'false' }}
        window.shamel_card_type_badge = {{ theme.settings.get('shamel_card_type_badge', true) ? 'true' : 'false' }}
        window.shamel_compare_enabled = {{ theme.settings.get('shamel_side_tools_enabled', true) and theme.settings.get('shamel_compare_enabled', true) ? 'true' : 'false' }}
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            /* Theme specific variables */
            --s-radius: .75rem;
        }
    </style>
    <style>
      .shamel-pro{background:var(--sp-page-bg,#fff);color:var(--sp-text,#334155)}
      .shamel-pro h1,.shamel-pro h2,.shamel-pro h3,.shamel-pro h4{color:var(--sp-heading,#0f172a)}
      .shamel-pro .main-nav-container,.shamel-pro .top-navbar{background:var(--sp-header-bg,#fff);color:var(--sp-header-text,#0f172a)}
      /* Shamel Pro — clean single-row header */
      .shamel-store-header .top-navbar{display:none!important}
      .shamel-header-main{min-height:4.8rem;border-bottom:1px solid color-mix(in srgb,var(--sp-header-text,#0f172a) 9%,transparent)}
      .shamel-header-main__grid{display:grid;grid-template-columns:minmax(6.5rem,9rem) minmax(0,1fr) auto;align-items:center;gap:1rem;min-height:4.8rem}
      .shamel-header-main__brand,.shamel-header-main__actions{display:flex;align-items:center}
      .shamel-header-main__brand{justify-content:flex-start;gap:.65rem}
      .shamel-header-main__brand .navbar-brand{margin:0;max-width:8rem}
      .shamel-header-main__menu{display:flex;align-items:center;justify-content:center;min-width:0;overflow:hidden}
      .shamel-header-main__menu custom-main-menu{display:block;width:100%;min-width:0}
      .shamel-header-main__menu .main-menu{display:flex!important;align-items:center;justify-content:center;flex-wrap:nowrap!important;gap:.2rem;white-space:nowrap}
      .shamel-header-main__menu .main-menu>li>a{padding-inline:.65rem;font-weight:700}
      .shamel-header-main__actions{justify-content:flex-end;gap:.55rem;white-space:nowrap}
      .shamel-header-search-trigger{display:grid;place-items:center;width:2.65rem;height:2.65rem;overflow:visible;border:1px solid color-mix(in srgb,var(--sp-header-text,#0f172a) 14%,transparent);border-radius:50%;transition:.2s}
      .shamel-header-search-trigger:hover{border-color:var(--sp-primary,#0f4c6b);background:color-mix(in srgb,var(--sp-primary,#0f4c6b) 8%,transparent)}
      .shamel-header-search-trigger salla-search{width:2.65rem}
      .shamel-header-main salla-cart-summary{margin:0!important}
      @media(max-width:1023px){
        .shamel-header-main{min-height:4.25rem}
        .shamel-header-main__grid{grid-template-columns:1fr auto;gap:.5rem;min-height:4.25rem}
        .shamel-header-main__brand .navbar-brand{max-width:6.5rem}
        .shamel-header-main__menu{display:none}
        .shamel-header-main__actions{gap:.35rem}
        .shamel-header-localization{display:none}
      }
      @media(max-width:420px){.shamel-header-main__brand .navbar-brand{max-width:5.4rem}}
      .shamel-pro .s-product-card-entry{background:var(--sp-card-bg,#fff)}
      .shamel-pro .store-footer,.shamel-pro .store-footer__inner{background:var(--sp-footer-bg,#0f172a);color:var(--sp-footer-text,#fff)}
      .shamel-pro .btn--primary,.shamel-pro salla-button[color=primary]{--color-primary:var(--sp-primary,#0f4c6b);--color-primary-reverse:var(--sp-button-text,#fff)}


      .shamel-compare-add{display:grid;place-items:center;flex:0 0 2.85rem;width:2.85rem;height:2.85rem;border:1px solid #cbd5e1;border-radius:.72rem;background:#fff;color:var(--sp-primary,#0f4c6b);cursor:pointer;transition:.18s}
      .shamel-compare-add:hover{border-color:var(--sp-primary,#0f4c6b);background:var(--sp-primary,#0f4c6b);color:#fff;transform:translateY(-2px)}
      body.shamel-dark-mode{--sp-page-bg:#070b14!important;--sp-text:#cbd5e1!important;--sp-heading:#f8fafc!important;--sp-card-bg:#111827!important;--sp-header-bg:#0b1120!important;--sp-header-text:#f8fafc!important;background:#070b14!important;color:#cbd5e1!important;color-scheme:dark}
      body.shamel-dark-mode header,body.shamel-dark-mode .navbar,body.shamel-dark-mode .main-menu,body.shamel-dark-mode .s-block,body.shamel-dark-mode .product-entry,body.shamel-dark-mode .product-card,body.shamel-dark-mode .s-product-card-entry,body.shamel-dark-mode .shamel-compare-drawer{background-color:var(--sp-card-bg,#111827)!important;color:var(--sp-text,#cbd5e1)!important}
      body.shamel-dark-mode h1,body.shamel-dark-mode h2,body.shamel-dark-mode h3,body.shamel-dark-mode h4,body.shamel-dark-mode h5,body.shamel-dark-mode h6,body.shamel-dark-mode a:not(.shamel-contact__link):not(.shamel-side-tools a){color:var(--sp-heading,#f8fafc)}
      body.shamel-dark-mode input,body.shamel-dark-mode select,body.shamel-dark-mode textarea{background:#172033!important;border-color:#334155!important;color:#f8fafc!important}
      body.shamel-dark-mode .shamel-compare-item{border-color:#334155;background:#111827}body.shamel-dark-mode .shamel-compare-item img{background:#172033}
      .shamel-side-tools [data-shamel-dark-toggle][aria-pressed="true"]{background:var(--sp-primary,#0f4c6b)}
      .shamel-side-tools[hidden]{display:none!important}
      .shamel-newsletter-drawer[hidden]{display:none!important}.shamel-newsletter-drawer{position:fixed;inset:0;z-index:101;display:grid;place-items:center;padding:1rem;background:rgba(2,6,23,.66);backdrop-filter:blur(5px)}
      .shamel-newsletter-drawer__card{position:relative;width:min(31rem,100%);padding:2rem;border-radius:1rem;background:var(--sp-card-bg,#fff);color:var(--sp-text,#334155);box-shadow:0 30px 90px rgba(2,6,23,.4);text-align:center}
      .shamel-newsletter-drawer__card h2{margin:0 0 .45rem;color:var(--sp-heading,#0f172a);font-size:1.55rem;font-weight:900}.shamel-newsletter-drawer__card p{margin:0 0 1rem}
      .shamel-newsletter-drawer__form{display:flex;gap:.55rem}.shamel-newsletter-drawer__form input{flex:1;min-width:0;padding:.85rem 1rem;border:1px solid #cbd5e1;border-radius:.65rem}.shamel-newsletter-drawer__form button{padding:.85rem 1.15rem;border:0;border-radius:.65rem;background:var(--sp-primary,#0f4c6b);color:var(--sp-button-text,#fff);font-weight:800;cursor:pointer}
      .shamel-newsletter-drawer__close{position:absolute;top:.6rem;left:.75rem;border:0;background:transparent;color:inherit;font-size:1.7rem;cursor:pointer}@media(max-width:480px){.shamel-newsletter-drawer__form{flex-direction:column}}
      .shamel-side-tools{transition:transform .28s ease,box-shadow .28s ease,width .28s ease,height .28s ease}
      .shamel-side-tools.is-collapsed{width:1.45rem;height:3.8rem;min-width:0;min-height:0;transform:none;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,.2)}
      .shamel-side-tools--left.is-collapsed{border-radius:0 .55rem .55rem 0}
      .shamel-side-tools--right.is-collapsed{border-radius:.55rem 0 0 .55rem}
      .shamel-side-tools [data-shamel-tools-open]{display:none}
      .shamel-side-tools.is-collapsed>[data-shamel-tools-open]{position:absolute;inset:0;display:flex!important;width:1.45rem;min-width:1.45rem;height:3.8rem;min-height:3.8rem;padding:0;opacity:1;pointer-events:auto;border:0;background:var(--sp-primary,#0f4c6b);font-size:1.15rem;font-weight:900;line-height:1}
      .shamel-side-tools.is-collapsed>:not([data-shamel-tools-open]){opacity:0;pointer-events:none}
      .shamel-side-tools__open-right{display:none}.shamel-side-tools--right .shamel-side-tools__open-left{display:none}.shamel-side-tools--right .shamel-side-tools__open-right{display:inline}
      .shamel-side-tools{position:fixed;top:44%;z-index:88;display:flex;flex-direction:column;align-items:stretch;overflow:hidden;border:1px solid rgba(148,163,184,.25);border-radius:0 .8rem .8rem 0;background:#0f172a;color:#fff;box-shadow:0 18px 45px rgba(15,23,42,.25)}
      .shamel-side-tools--left{left:0}.shamel-side-tools--right{right:0;border-radius:.8rem 0 0 .8rem}
      .shamel-side-tools button,.shamel-side-tools a{position:relative;display:flex;align-items:center;justify-content:center;gap:.45rem;min-width:3rem;min-height:3rem;padding:.65rem;border:0;border-bottom:1px solid rgba(255,255,255,.12);background:transparent;color:inherit;text-decoration:none;cursor:pointer}
      .shamel-side-tools button:hover,.shamel-side-tools a:hover{background:var(--sp-primary,#0f4c6b)}
      .shamel-side-tools__label{font-size:.76rem;font-weight:800;writing-mode:vertical-rl;transform:rotate(180deg)}
      .shamel-side-tools__count{position:absolute;top:.25rem;right:.25rem;display:grid;place-items:center;min-width:1.15rem;height:1.15rem;padding:0 .2rem;border-radius:999px;background:#ef4444;color:#fff;font-size:.62rem;font-weight:900}
      .shamel-compare-drawer[hidden]{display:none}.shamel-compare-drawer{position:fixed;z-index:100;top:50%;left:50%;width:min(54rem,calc(100% - 2rem));max-height:80vh;overflow:auto;transform:translate(-50%,-50%);border-radius:1rem;background:#fff;color:#0f172a;box-shadow:0 30px 90px rgba(2,6,23,.38)}
      .shamel-compare-drawer__head{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:1rem 1.2rem;background:#0f172a;color:#fff}.shamel-compare-drawer__head h2{margin:0;color:#fff;font-size:1.2rem;font-weight:900}.shamel-compare-drawer__close{border:0;background:transparent;color:#fff;font-size:1.5rem;cursor:pointer}
      .shamel-compare-drawer__items{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem;padding:1rem}.shamel-compare-item{position:relative;padding:.7rem;border:1px solid #e2e8f0;border-radius:.8rem;text-align:center}.shamel-compare-item img{width:100%;aspect-ratio:1/1;object-fit:contain;border-radius:.55rem;background:#f8fafc}.shamel-compare-item h3{margin:.55rem 0 .3rem;font-size:.85rem;font-weight:800}.shamel-compare-item strong{color:var(--sp-primary,#0f4c6b)}.shamel-compare-item__remove{position:absolute;top:.35rem;right:.35rem;display:grid;place-items:center;width:1.8rem;height:1.8rem;border:0;border-radius:50%;background:#fff;color:#dc2626;box-shadow:0 3px 10px rgba(15,23,42,.15);cursor:pointer}.shamel-compare-empty{grid-column:1/-1;padding:2rem;text-align:center;color:#64748b}
      @media(max-width:640px){.shamel-side-tools{top:auto;bottom:max(.35rem,env(safe-area-inset-bottom));left:50%;right:auto;flex-direction:row;transform:translateX(-50%);border-radius:999px}.shamel-side-tools__label{display:none}.shamel-side-tools button,.shamel-side-tools a{border-bottom:0;border-inline-end:1px solid rgba(255,255,255,.12)}.shamel-compare-drawer__items{grid-template-columns:repeat(2,minmax(0,1fr))}}

      /* Shamel Pro: conversion-focused product cards */
      .shamel-pro .s-product-card-entry{overflow:hidden;border:1px solid rgba(148,163,184,.22);border-radius:var(--s-radius,.75rem);box-shadow:0 4px 16px rgba(15,23,42,.05);transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}
      .shamel-pro .s-product-card-entry:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--sp-primary,#0f4c6b) 35%,transparent);box-shadow:0 16px 34px rgba(15,23,42,.11)}
      .shamel-pro .s-product-card-image{overflow:hidden;background:#f8fafc}
      .shamel-pro .s-product-card-image img{transition:transform .35s ease}
      .shamel-pro .s-product-card-entry:hover .s-product-card-image img{transform:scale(1.035)}
      .shamel-pro .s-product-card-content{padding-bottom:.85rem}
      .shamel-pro .s-product-card-content-title{font-weight:800;line-height:1.55}
      .shamel-pro .s-product-card-content-title a{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2}
      .shamel-pro .s-product-card-content-sub{align-items:center;min-height:2.4rem}
      .shamel-pro .s-product-card-price,.shamel-pro .s-product-card-sale-price h4{color:var(--sp-primary,#0f4c6b);font-size:1.08rem;font-weight:900}
      .shamel-pro .s-product-card-sale-price span{text-decoration-thickness:1.5px;color:#94a3b8}
      .shamel-pro .s-product-card-rating{display:inline-flex;align-items:center;gap:.25rem;padding:.22rem .45rem;border-radius:999px;background:#fff7ed;color:#9a3412;font-weight:800}
      .shamel-pro .s-product-card-content-footer salla-add-product-button{flex:1}
      .shamel-pro .s-product-card-content-footer salla-add-product-button::part(button){min-height:2.85rem;border-radius:.72rem;font-weight:800}
      .shamel-pro .s-product-card-wishlist-btn{transition:transform .18s ease}
      .shamel-pro .s-product-card-wishlist-btn:hover{transform:scale(1.08)}
      @media(max-width:640px){
        .shamel-pro .s-product-card-entry:hover{transform:none}
        .shamel-pro .s-product-card-content{padding-bottom:.65rem}
        .shamel-pro .s-product-card-content-title{font-size:.9rem}
        .shamel-pro .s-product-card-price,.shamel-pro .s-product-card-sale-price h4{font-size:1rem}
        .is-sticky-product-bar .product-form{padding-bottom:max(.35rem,env(safe-area-inset-bottom))}
      }

      .shamel-card-badges{position:absolute;z-index:3;top:.7rem;right:.7rem;display:flex;flex-direction:column;align-items:flex-start;gap:.35rem;pointer-events:none}
      html[dir=ltr] .shamel-card-badges{right:auto;left:.7rem}
      .shamel-card-badge{display:inline-flex;align-items:center;min-height:1.65rem;padding:.25rem .55rem;border-radius:999px;color:#fff;font-size:.7rem;font-weight:800;line-height:1;box-shadow:0 5px 14px rgba(15,23,42,.18)}
      .shamel-card-badge--sale{background:#dc2626}.shamel-card-badge--digital{background:#7c3aed}.shamel-card-badge--service{background:#0369a1}
      .shamel-product-trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;margin:1.25rem 0}
      .shamel-product-trust__item{display:flex;align-items:center;justify-content:center;gap:.45rem;min-height:3.4rem;padding:.65rem;border:1px solid #e2e8f0;border-radius:.8rem;background:var(--sp-card-bg,#fff);color:var(--sp-text,#334155);font-size:.78rem;font-weight:700;text-align:center}
      .shamel-product-trust__item i{color:var(--sp-primary,#0f4c6b);font-size:1.15rem}
      @media(max-width:640px){.shamel-product-trust{grid-template-columns:1fr}.shamel-product-trust__item{justify-content:flex-start}}

      .shamel-news-wrap{position:relative;margin:.75rem auto 1.5rem;padding:0 .75rem}
      .shamel-news{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:.85rem;background:linear-gradient(110deg,var(--sp-news-bg,#071a2f),color-mix(in srgb,var(--sp-news-bg,#071a2f) 74%,var(--sp-primary,#0f4c6b)));color:var(--sp-news-text,#fff);box-shadow:0 12px 30px rgba(2,6,23,.18),inset 0 1px 0 rgba(255,255,255,.1);white-space:nowrap}
      .shamel-news:before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 20%,rgba(255,255,255,.1) 42%,transparent 62%);transform:translateX(-100%);animation:shamel-news-shine 7s ease-in-out infinite;pointer-events:none}
      .shamel-news__row{display:flex;align-items:center;min-height:3.15rem}
      .shamel-news__viewport{min-width:0;flex:1;overflow:hidden}
      .shamel-news__track{display:flex;width:max-content;align-items:center;will-change:transform;animation:shamel-news 28s linear infinite}
      .shamel-news--slow .shamel-news__track{animation-duration:42s}.shamel-news--fast .shamel-news__track{animation-duration:18s}
      .shamel-news__sequence{display:inline-flex;align-items:center;gap:2.1rem;padding-inline:1.1rem;font-size:.84rem;font-weight:800}
      .shamel-news__message{display:inline-flex;align-items:center;gap:.55rem}.shamel-news__message:before{content:"✦";color:#fbbf24}
      .shamel-news__payment-set{display:inline-flex;align-items:center;gap:.65rem}
      .shamel-pay-logo{display:grid;place-items:center;min-width:3rem;height:1.62rem;padding:0 .45rem;border:1px solid rgba(255,255,255,.74);border-radius:.42rem;background:#fff;color:#111827;box-shadow:0 3px 8px rgba(2,6,23,.14);font:900 .65rem/1 Arial,sans-serif}
      .shamel-pay-logo--mada{color:#14a37f}.shamel-pay-logo--visa{color:#1434CB;font-size:.78rem;font-style:italic}.shamel-pay-logo--apple{font-size:.7rem}.shamel-pay-logo--stc{color:#4f008c}.shamel-pay-logo--tabby{background:#3ee6c4;color:#111}.shamel-pay-logo--tamara{background:#f6b8c8;color:#111}.shamel-pay-logo--google{color:#4285f4}.shamel-pay-logo--mispay{background:#151515;color:#fff}.shamel-pay-logo--madfu{background:#5b2f91;color:#fff}.shamel-pay-logo--emkan{background:#006b5b;color:#fff}
      .shamel-pay-logo--bank,.shamel-pay-logo--sarie,.shamel-pay-logo--cod{display:flex;gap:.25rem;white-space:nowrap}.shamel-pay-logo--bank{color:#075985}.shamel-pay-logo--sarie{background:#0b6b5c;color:#fff}.shamel-pay-logo--cod{background:#fff7ed;color:#9a3412}.shamel-pay-logo svg{width:.82rem;height:.82rem;fill:currentColor}
      .shamel-pay-logo--mastercard{min-width:2.45rem}.shamel-pay-logo--mastercard span{position:relative;width:1.55rem;height:.92rem}.shamel-pay-logo--mastercard span:before,.shamel-pay-logo--mastercard span:after{content:"";position:absolute;top:0;width:.92rem;height:.92rem;border-radius:50%}.shamel-pay-logo--mastercard span:before{left:0;background:#eb001b}.shamel-pay-logo--mastercard span:after{right:0;background:#f79e1b;mix-blend-mode:multiply}
      .shamel-pay-logo--custom{min-width:auto;padding:.18rem .5rem}.shamel-pay-logo--custom img{display:block;width:auto;max-width:4.5rem;height:1.15rem;object-fit:contain}
      @keyframes shamel-news{to{transform:translateX(50%)}}@keyframes shamel-news-shine{0%,35%{transform:translateX(-100%)}70%,100%{transform:translateX(100%)}}
      html[dir=ltr] .shamel-news__track{animation-direction:reverse}
      @media(max-width:720px){.shamel-news-wrap{padding:0 .5rem}.shamel-news__row{min-height:2.9rem}.shamel-news__sequence{gap:1.35rem;font-size:.77rem}.shamel-pay-logo{min-width:2.65rem;height:1.5rem}}
      .shamel-follow{margin-top:3rem;padding:2.25rem 0;background:var(--shamel-follow-bg,#071a2f);color:var(--shamel-follow-text,#fff)}
      .shamel-follow__inner{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.15rem;text-align:center}.shamel-follow h2{margin:0 0 .4rem;font-size:1.45rem;font-weight:800}.shamel-follow p{margin:0;color:rgba(255,255,255,.75)}
      .shamel-follow__links{display:flex;justify-content:center;flex-wrap:wrap;gap:.65rem}.shamel-follow__links a{display:grid;place-items:center;width:3rem;height:3rem;border:1px solid currentColor;border-radius:.8rem;background:rgba(255,255,255,.1);color:var(--shamel-follow-icon,#fff);font-size:1.25rem;transition:.2s}.shamel-follow__links a:hover{transform:translateY(-3px);background:var(--shamel-follow-icon,#fff);color:var(--shamel-follow-bg,#071a2f)}
      .shamel-social-svg{display:block;width:1.5rem;height:1.5rem;overflow:visible;fill:currentColor;filter:drop-shadow(0 1px 1px rgba(0,0,0,.12));transform:translateZ(0)}
      .shamel-social-svg path{shape-rendering:geometricPrecision}
      .shamel-follow__links a[class*="shamel-social--"],.shamel-contact__link[class*="shamel-social--"]{isolation:isolate;background:var(--shamel-brand);color:var(--shamel-brand-icon);border-color:rgba(255,255,255,.82);box-shadow:0 8px 22px rgba(15,23,42,.22),inset 0 1px 0 rgba(255,255,255,.28)}
      .shamel-follow__links a[class*="shamel-social--"]:focus-visible,.shamel-contact__link[class*="shamel-social--"]:focus-visible{outline:3px solid rgba(56,189,248,.7);outline-offset:3px}
      .shamel-social--whatsapp{--shamel-brand:#25D366;--shamel-brand-icon:#fff}
      .shamel-social--instagram{--shamel-brand:linear-gradient(135deg,#833AB4,#FD1D1D,#FCAF45);--shamel-brand-icon:#fff}
      .shamel-social--tiktok{--shamel-brand:#010101;--shamel-brand-icon:#fff}
      .shamel-social--snapchat{--shamel-brand:#FFFC00;--shamel-brand-icon:#000}
      .shamel-social--x{--shamel-brand:#000;--shamel-brand-icon:#fff}
      .shamel-social--youtube{--shamel-brand:#FF0000;--shamel-brand-icon:#fff}
      .shamel-social--facebook{--shamel-brand:#1877F2;--shamel-brand-icon:#fff}
      .shamel-follow__links a[class*="shamel-social--"],.shamel-contact__link[class*="shamel-social--"]{background:var(--shamel-brand);color:var(--shamel-brand-icon)}
      .shamel-follow__links a[class*="shamel-social--"]:hover,.shamel-contact__link[class*="shamel-social--"]:hover{background:var(--shamel-brand);color:var(--shamel-brand-icon)}

      .shamel-popup[hidden]{display:none}.shamel-popup{position:fixed;inset:0;z-index:120;display:grid;place-items:center;padding:1rem;background:rgba(2,6,23,.66);backdrop-filter:blur(5px)}
      .shamel-popup__card{position:relative;display:grid;grid-template-columns:minmax(14rem,.85fr) minmax(18rem,1fr);width:min(56rem,100%);overflow:hidden;border-radius:1.4rem;background:var(--sp-popup-bg,#fff);color:var(--sp-popup-text,#0f172a);box-shadow:0 30px 80px rgba(2,6,23,.35)}
      .shamel-popup__image{min-height:30rem;background:#eef2f7 center/cover no-repeat}.shamel-popup__content{display:flex;flex-direction:column;justify-content:center;padding:2.4rem}
      .shamel-popup__close{position:absolute;top:.8rem;right:.8rem;z-index:2;width:2.4rem;height:2.4rem;border:0;border-radius:50%;background:rgba(255,255,255,.9);color:#0f172a;font-size:1.35rem;cursor:pointer}
      .shamel-popup__eyebrow{color:#b45309;font-weight:800}.shamel-popup h2{margin:.65rem 0;font-size:2rem;line-height:1.3;font-weight:900;color:var(--sp-popup-text,#0f172a)}.shamel-popup p{color:#64748b;line-height:1.8}
      .shamel-popup form{display:grid;gap:.75rem;margin-top:1rem}.shamel-popup input{min-height:3.2rem;padding:.8rem 1rem;border:1px solid #cbd5e1;border-radius:.8rem}.shamel-popup button[type=submit]{min-height:3.2rem;border:0;border-radius:.8rem;background:var(--sp-primary,#0f4c6b);color:var(--sp-button-text,#fff);font-weight:800;cursor:pointer}.shamel-popup__privacy{font-size:.72rem;color:#94a3b8}
      @media(max-width:640px){.shamel-follow__inner{align-items:flex-start;flex-direction:column}.shamel-popup__card{display:block;max-height:92vh;overflow:auto}.shamel-popup__image{min-height:13rem}.shamel-popup__content{padding:1.5rem}.shamel-popup h2{font-size:1.55rem}}
      @media(prefers-reduced-motion:reduce){.shamel-news__track,.shamel-contact__link--whatsapp,.shamel-contact__link--whatsapp:before,.shamel-contact__link--whatsapp:after{animation:none}}
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
