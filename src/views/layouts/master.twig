        {% endif %}
        {% if theme.settings.get('shamel_tiktok_enabled') and theme.settings.get('shamel_tiktok_url') %}
          <a class="shamel-contact__link shamel-social--tiktok" href="{{ theme.settings.get('shamel_tiktok_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.6 3c.4 2.3 1.8 3.8 4.1 4.2v3.2c-1.5 0-2.9-.5-4.1-1.3v6.1a6.2 6.2 0 1 1-5.4-6.1v3.3a3 3 0 1 0 2.2 2.9V3h3.2Z"/></svg><span>TikTok</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_snapchat_enabled') and theme.settings.get('shamel_snapchat_url') %}
          <a class="shamel-contact__link shamel-social--snapchat" href="{{ theme.settings.get('shamel_snapchat_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c3.1 0 5.1 2.4 5.1 5.5 0 1.2-.2 2.2.2 2.5.5.4 1.5-.1 1.9.7.3.7-.6 1.2-1.6 1.6-.5.2-.6.5-.4.9.6 1.3 1.7 2.1 3.2 2.7.5.2.4 1-.1 1.1-.7.2-1.4.2-1.8.5-.5.4-.3 1.3-1.1 1.4-.5.1-1.1-.3-2.1.1-1 .4-1.7 1-3.3 1s-2.3-.6-3.3-1c-1-.4-1.6 0-2.1-.1-.8-.1-.6-1-1.1-1.4-.4-.3-1.1-.3-1.8-.5-.5-.1-.6-.9-.1-1.1 1.5-.6 2.6-1.4 3.2-2.7.2-.4.1-.7-.4-.9-1-.4-1.9-.9-1.6-1.6.4-.8 1.4-.3 1.9-.7.4-.3.2-1.3.2-2.5C6.9 4.4 8.9 2 12 2Z"/></svg><span>Snapchat</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_x_enabled') and theme.settings.get('shamel_x_url') %}
          <a class="shamel-contact__link shamel-social--x" href="{{ theme.settings.get('shamel_x_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23.2 22H17l-4.9-6.4L6.5 22H3.3l7.3-8.4L2.8 2H9l4.4 5.8L18.9 2Zm-1.1 17.8h1.7L8 4.1H6.2l11.6 15.7Z"/></svg><span>X</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_youtube_enabled') and theme.settings.get('shamel_youtube_url') %}
          <a class="shamel-contact__link shamel-social--youtube" href="{{ theme.settings.get('shamel_youtube_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg><span>YouTube</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_facebook_enabled') and theme.settings.get('shamel_facebook_url') %}
          <a class="shamel-contact__link shamel-social--facebook" href="{{ theme.settings.get('shamel_facebook_url') }}" target="_blank" rel="noopener noreferrer"><svg class="shamel-social-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 8.5V6.8c0-.8.5-1 1-1h2.8V2.2L15.1 2C11.8 2 10 4 10 6.4v2.1H7v4h3V22h4v-9.5h3.3l.5-4H14Z"/></svg><span>Facebook</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_email_enabled') and theme.settings.get('shamel_email') %}
          <a class="shamel-contact__link" href="mailto:{{ theme.settings.get('shamel_email') }}"><i class="sicon-mail" aria-hidden="true"></i><span>البريد</span></a>
        {% endif %}
        {% if theme.settings.get('shamel_phone_enabled') and theme.settings.get('shamel_phone') %}
          <a class="shamel-contact__link" href="tel:{{ theme.settings.get('shamel_phone') }}"><i class="sicon-phone" aria-hidden="true"></i><span>اتصال</span></a>
        {% endif %}
      </nav>
    </div>
  </div>
  <style>
    .shamel-contact{position:fixed;bottom:max(1rem,env(safe-area-inset-bottom));z-index:90;font-family:var(--font-main)}
    .shamel-contact--right{right:1rem}.shamel-contact--left{left:1rem}
    .shamel-contact__details{display:flex;flex-direction:row-reverse;align-items:center;gap:.7rem;filter:drop-shadow(0 12px 24px rgba(15,23,42,.14))}
    .shamel-contact__promo{position:relative;max-width:15rem;padding:.72rem 1rem;border:1px solid rgba(148,163,184,.22);border-radius:1rem;background:#fff;color:#0f172a;font-size:.86rem;font-weight:700;line-height:1.45;box-shadow:0 10px 28px rgba(15,23,42,.12)}
    .shamel-contact--right .shamel-contact__promo:after{content:"";position:absolute;right:-.38rem;top:50%;width:.72rem;height:.72rem;background:#fff;border-top:1px solid rgba(148,163,184,.22);border-right:1px solid rgba(148,163,184,.22);transform:translateY(-50%) rotate(45deg)}
    .shamel-contact--left .shamel-contact__promo:after{content:"";position:absolute;left:-.38rem;top:50%;width:.72rem;height:.72rem;background:#fff;border-bottom:1px solid rgba(148,163,184,.22);border-left:1px solid rgba(148,163,184,.22);transform:translateY(-50%) rotate(45deg)}
    .shamel-contact__menu{display:flex;align-items:center;flex-wrap:wrap;justify-content:flex-end;gap:.5rem;max-width:13rem}
    .shamel-contact--left .shamel-contact__menu{justify-content:flex-start}
    .shamel-contact__link{position:relative;display:grid;place-items:center;width:3.35rem;height:3.35rem;padding:0;border:3px solid rgba(255,255,255,.95);border-radius:50%;background:var(--sp-social-bg,#0f4c6b);color:var(--sp-social-icon,#fff);text-decoration:none;box-shadow:0 10px 26px rgba(15,76,107,.28);transition:transform .18s ease,box-shadow .18s ease,background .18s ease}
    .shamel-contact__link:hover{background:#123f59;transform:translateY(-3px) scale(1.04);box-shadow:0 14px 30px rgba(15,76,107,.34)}
    .shamel-contact__link i,.shamel-contact__glyph{width:auto;text-align:center;font-size:1.45rem;color:inherit}
    .shamel-contact__link--whatsapp{isolation:isolate;width:3.8rem;height:3.8rem;background:var(--sp-whatsapp,#22c55e);box-shadow:0 12px 30px rgba(34,197,94,.42),inset 0 1px 0 rgba(255,255,255,.45);animation:shamel-whatsapp-float 2.7s ease-in-out infinite}
    .shamel-contact__link--whatsapp:before{content:"";position:absolute;z-index:-1;inset:-.42rem;border:2px solid rgba(34,197,94,.38);border-radius:50%;animation:shamel-whatsapp-pulse 2.2s ease-out infinite}
    .shamel-contact__link--whatsapp:after{content:"";position:absolute;inset:3px;border-radius:50%;background:linear-gradient(120deg,transparent 22%,rgba(255,255,255,.55) 42%,transparent 61%);transform:translateX(-120%);animation:shamel-whatsapp-shine 3.2s ease-in-out infinite;pointer-events:none}
    .shamel-contact__link--whatsapp i{font-size:1.75rem;text-shadow:0 2px 5px rgba(0,0,0,.14)}
    .shamel-contact__link--whatsapp:hover{background:linear-gradient(145deg,#4ade80,#15803d);transform:translateY(-4px) scale(1.06)}
    @keyframes shamel-whatsapp-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
    @keyframes shamel-whatsapp-pulse{0%{opacity:.75;transform:scale(.9)}70%,100%{opacity:0;transform:scale(1.28)}}
    @keyframes shamel-whatsapp-shine{0%,35%{transform:translateX(-120%)}65%,100%{transform:translateX(120%)}}
    .shamel-contact__link>span:last-child:not(.shamel-contact__glyph){position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:480px){.shamel-contact{bottom:max(.75rem,env(safe-area-inset-bottom))}.shamel-contact--right{right:.75rem}.shamel-contact--left{left:.75rem}.shamel-contact__details{gap:.5rem}.shamel-contact__promo{max-width:10.5rem;padding:.58rem .72rem;font-size:.75rem}.shamel-contact__menu{max-width:7.2rem;gap:.35rem}.shamel-contact__link{width:3.1rem;height:3.1rem}.shamel-contact__link i,.shamel-contact__glyph{font-size:1.3rem}}
  </style>
{% endif %}


{% if theme.settings.get('shamel_side_tools_enabled', true) %}
  {% set shamel_tools_position_raw = theme.settings.get('shamel_side_tools_position', 'left') %}
  {% set shamel_tools_position = shamel_tools_position_raw is iterable ? (shamel_tools_position_raw|first).value : shamel_tools_position_raw %}
  <nav class="shamel-side-tools shamel-side-tools--{{ shamel_tools_position }}" aria-label="أدوات المتجر" data-shamel-side-tools>
    {% if theme.settings.get('shamel_compare_enabled', true) %}
      <button type="button" data-shamel-compare-open title="مقارنة المنتجات"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7 3h2v14h3l-4 4-4-4h3V3Zm10 18h-2V7h-3l4-4 4 4h-3v14Z"/></svg><span class="shamel-side-tools__label">المقارنة</span><span class="shamel-side-tools__count" data-shamel-compare-count>0</span></button>
    {% endif %}
    {% if theme.settings.get('shamel_side_newsletter_enabled', true) %}
      <button type="button" data-shamel-newsletter-open title="اشترك في نشرتنا البريدية"><i class="sicon-mail" aria-hidden="true"></i><span class="shamel-side-tools__label">اشترك في نشرتنا</span></button>
    {% endif %}
    {% if theme.settings.get('shamel_side_wishlist_enabled', true) %}
      <a href="{{ link('wishlist') }}" title="المفضلة"><i class="sicon-heart" aria-hidden="true"></i><span class="shamel-side-tools__label">المفضلة</span></a>
    {% endif %}
    {% if theme.settings.get('shamel_dark_mode_enabled', true) %}
      <button type="button" data-shamel-dark-toggle aria-pressed="false" title="الوضع الليلي"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.7 15.1A8.5 8.5 0 0 1 8.9 3.3 9 9 0 1 0 20.7 15Z"/></svg><span class="shamel-side-tools__label" data-shamel-dark-label>الوضع الليلي</span></button>
    {% endif %}
    <button type="button" data-shamel-tools-close aria-label="طي شريط الأدوات" title="طي الأدوات">×</button>
    <button type="button" data-shamel-tools-open aria-label="فتح شريط الأدوات" title="فتح الأدوات"><span class="shamel-side-tools__open-left">›</span><span class="shamel-side-tools__open-right">‹</span></button>
  </nav>
  {% if theme.settings.get('shamel_side_newsletter_enabled', true) %}
    <section class="shamel-newsletter-drawer" data-shamel-newsletter-drawer hidden role="dialog" aria-modal="true" aria-labelledby="shamel-newsletter-title">
      <div class="shamel-newsletter-drawer__card">
        <button type="button" class="shamel-newsletter-drawer__close" data-shamel-newsletter-close aria-label="إغلاق">×</button>
        <h2 id="shamel-newsletter-title">اشترك في نشرتنا البريدية</h2>
        <p>كن أول من يعرف بالعروض والمنتجات الجديدة.</p>
        <form class="shamel-newsletter-drawer__form" data-shamel-newsletter-form{% if theme.settings.get('shamel_popup_action_url') %} action="{{ theme.settings.get('shamel_popup_action_url') }}" method="post"{% endif %}>
          <input type="email" name="email" autocomplete="email" required placeholder="أدخل بريدك الإلكتروني" aria-label="البريد الإلكتروني">
          <button type="submit">اشترك الآن</button>
        </form>
      </div>
    </section>
  {% endif %}
  {% if theme.settings.get('shamel_compare_enabled', true) %}
    <section class="shamel-compare-drawer" data-shamel-compare-drawer hidden role="dialog" aria-modal="true" aria-labelledby="shamel-compare-title">
      <header class="shamel-compare-drawer__head"><h2 id="shamel-compare-title">مقارنة المنتجات</h2><button type="button" class="shamel-compare-drawer__close" data-shamel-compare-close aria-label="إغلاق">×</button></header>
      <div class="shamel-compare-drawer__items" data-shamel-compare-items></div>
    </section>
  {% endif %}
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      var toolsBar=document.querySelector('[data-shamel-side-tools]');
      if(!toolsBar)return;
      var darkButton=toolsBar.querySelector('[data-shamel-dark-toggle]');
      var darkKey='shamel_dark_mode';
      function applyDarkMode(enabled){
        document.body.classList.toggle('shamel-dark-mode',enabled);
        if(darkButton){
          darkButton.setAttribute('aria-pressed',enabled?'true':'false');
          darkButton.title=enabled?'الوضع الفاتح':'الوضع الليلي';
          var label=darkButton.querySelector('[data-shamel-dark-label]');
          if(label)label.textContent=enabled?'الوضع الفاتح':'الوضع الليلي';
        }
      }
      var savedDark=localStorage.getItem(darkKey);
      var darkEnabled=savedDark===null?window.matchMedia('(prefers-color-scheme:dark)').matches:savedDark==='dark';
      applyDarkMode(darkEnabled);
      if(darkButton)darkButton.addEventListener('click',function(){
        darkEnabled=!document.body.classList.contains('shamel-dark-mode');
        localStorage.setItem(darkKey,darkEnabled?'dark':'light');
        applyDarkMode(darkEnabled);
      });
      var key='shamel_compare_products',items=[];
      try{items=JSON.parse(localStorage.getItem(key)||'[]')}catch(e){items=[]}
      var drawer=document.querySelector('[data-shamel-compare-drawer]');
      var list=document.querySelector('[data-shamel-compare-items]');
      function safe(value){var div=document.createElement('div');div.textContent=value||'';return div.innerHTML}
      function render(){
        document.querySelectorAll('[data-shamel-compare-count]').forEach(function(el){el.textContent=items.length});
        if(!list)return;
        if(!items.length){list.innerHTML='<div class="shamel-compare-empty">أضف منتجات من بطاقات المتجر لتظهر هنا.</div>';return}
        list.innerHTML=items.map(function(item,index){return '<article class="shamel-compare-item"><button type="button" class="shamel-compare-item__remove" data-remove="'+index+'" aria-label="إزالة">×</button><a href="'+safe(item.url)+'"><img src="'+safe(item.image)+'" alt="'+safe(item.name)+'"><h3>'+safe(item.name)+'</h3></a><strong>'+safe(item.price)+'</strong></article>'}).join('');
        list.querySelectorAll('[data-remove]').forEach(function(btn){btn.addEventListener('click',function(){items.splice(Number(btn.dataset.remove),1);localStorage.setItem(key,JSON.stringify(items));render()})});
      }
      window.addEventListener('shamel:compare:add',function(e){
        var product=e.detail;if(!product)return;
        var exists=items.findIndex(function(x){return String(x.id)===String(product.id)});
        if(exists>=0){items.splice(exists,1)}else if(items.length<4){items.push(product)}else{if(window.salla&&salla.notify)salla.notify.warning('يمكن مقارنة 4 منتجات كحد أقصى');return}
        localStorage.setItem(key,JSON.stringify(items));render();
        if(window.salla&&salla.notify)salla.notify.success(exists>=0?'تمت إزالة المنتج من المقارنة':'تمت إضافة المنتج للمقارنة');
      });
      document.querySelectorAll('[data-shamel-compare-open]').forEach(function(btn){btn.addEventListener('click',function(){if(drawer)drawer.hidden=false})});
      document.querySelectorAll('[data-shamel-compare-close]').forEach(function(btn){btn.addEventListener('click',function(){if(drawer)drawer.hidden=true})});
      var newsletterDrawer=document.querySelector('[data-shamel-newsletter-drawer]');
      document.querySelectorAll('[data-shamel-newsletter-open]').forEach(function(btn){btn.addEventListener('click',function(){if(newsletterDrawer)newsletterDrawer.hidden=false})});
      document.querySelectorAll('[data-shamel-newsletter-close]').forEach(function(btn){btn.addEventListener('click',function(){if(newsletterDrawer)newsletterDrawer.hidden=true})});
      if(newsletterDrawer)newsletterDrawer.addEventListener('click',function(e){if(e.target===newsletterDrawer)newsletterDrawer.hidden=true});
      var newsletterForm=document.querySelector('[data-shamel-newsletter-form]');
      if(newsletterForm&&!newsletterForm.getAttribute('action'))newsletterForm.addEventListener('submit',function(e){e.preventDefault();if(window.salla&&salla.notify)salla.notify.warning('أضف رابط استقبال الاشتراكات من إعدادات الثيم أولًا')});
      var close=toolsBar.querySelector('[data-shamel-tools-close]');
      var open=toolsBar.querySelector('[data-shamel-tools-open]');
      if(close)close.onclick=function(e){e.preventDefault();e.stopPropagation();toolsBar.classList.add('is-collapsed');toolsBar.setAttribute('aria-expanded','false')};
      if(open)open.onclick=function(e){e.preventDefault();e.stopPropagation();toolsBar.classList.remove('is-collapsed');toolsBar.setAttribute('aria-expanded','true')};
      render();
    });
  </script>
{% endif %}

{% if theme.settings.get('shamel_popup_enabled') and theme.settings.get('shamel_popup_action_url') %}
  <div id="shamel-marketing-popup" class="shamel-popup" hidden role="dialog" aria-modal="true" aria-labelledby="shamel-popup-title">
    <div class="shamel-popup__card">
      <button type="button" class="shamel-popup__close" aria-label="إغلاق">×</button>
      <div class="shamel-popup__image"{% if theme.settings.get('shamel_popup_image') %} style="background-image:url('{{ theme.settings.get('shamel_popup_image') }}')"{% endif %}></div>
      <div class="shamel-popup__content">
        <span class="shamel-popup__eyebrow">{{ theme.settings.get('shamel_popup_eyebrow', 'خصم خاص') }}</span>
        <h2 id="shamel-popup-title">{{ theme.settings.get('shamel_popup_title', 'احصل على خصم على أول طلب لك') }}</h2>
        <p>{{ theme.settings.get('shamel_popup_description', 'سجّل بياناتك لتصلك أحدث العروض والإصدارات.') }}</p>
        <form action="{{ theme.settings.get('shamel_popup_action_url') }}" method="post" target="shamel-popup-target">
          {% if shamel_popup_capture == 'phone' %}
            <input type="tel" name="phone" autocomplete="tel" required placeholder="أدخل رقم الجوال">
          {% else %}
            <input type="email" name="email" autocomplete="email" required placeholder="أدخل بريدك الإلكتروني">
          {% endif %}
          <button type="submit">{{ theme.settings.get('shamel_popup_button', 'احصل على العرض') }}</button>
          <small class="shamel-popup__privacy">بالتسجيل أنت توافق على استلام الرسائل التسويقية، ويمكنك إلغاء الاشتراك لاحقًا.</small>
        </form>
        <iframe name="shamel-popup-target" title="استقبال التسجيل" hidden></iframe>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var popup = document.getElementById('shamel-marketing-popup');
      if (!popup) return;
      var key = 'shamel_popup_hidden_until';
      var hiddenUntil = Number(localStorage.getItem(key) || 0);
      if (Date.now() < hiddenUntil) return;
      window.setTimeout(function(){ popup.hidden = false; }, 1600);
      function closePopup(){ popup.hidden = true; localStorage.setItem(key, String(Date.now() + 604800000)); }
      popup.querySelector('.shamel-popup__close').addEventListener('click', closePopup);
      popup.addEventListener('click', function(e){ if(e.target === popup) closePopup(); });
      popup.querySelector('form').addEventListener('submit', function(){ window.setTimeout(closePopup, 250); });
    });
  </script>
{% endif %}
</body>
</html>
