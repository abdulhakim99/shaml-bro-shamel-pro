{#
| Header is connected to Salla Navigation.
| Merchants manage main/sub categories once from the store navigation screen.
#}
{% set shamel_show_header_categories = theme.settings.get('shamel_header_categories_enabled_v2', true) %}
<header data-testid="store-header" class="store-header shamel-store-header">
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  <div id="mainnav" class="main-nav-container shamel-header-main">
    <div class="inner w-full">
      <div class="container">
        <div class="shamel-pro-header-shell">
          <div class="shamel-header-main__grid shamel-header-main__grid--drawer">
            <div class="shamel-header-main__account" aria-label="السلة والحساب والبحث">
              <salla-cart-summary data-testid="store-header-cart">
                <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
              </salla-cart-summary>
              <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
              <div class="shamel-header-search-trigger" data-shamel-header-search>
                <button type="button" class="shamel-header-icon-button shamel-header-search-button" data-shamel-header-search-button aria-label="فتح البحث" aria-expanded="false">
                  <i class="sicon-search" aria-hidden="true"></i>
                </button>
                <div class="shamel-header-search-panel">
                  <salla-search data-testid="store-header-search" inline oval height="48" aria-label="البحث عن المنتجات"></salla-search>
                </div>
              </div>
            </div>

            <a data-testid="store-header-logo" class="navbar-brand shamel-header-main__brand" href="{{ store.url }}">
              <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(300) }}" alt="{{ store.name }} logo">
              {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% else %}<h2 class="sr-only">{{ store.name }}</h2>{% endif %}
            </a>

            <div class="shamel-header-main__tools" aria-label="أدوات العرض والتنقل">
              {% if store.settings.is_multilingual %}
                <div class="shamel-header-localization" title="اللغة والعملة">
                  <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
                </div>
              {% endif %}
              {% if theme.settings.get('shamel_dark_mode_enabled', true) %}
                <button type="button" class="shamel-header-icon-button shamel-header-dark-toggle" data-shamel-dark-toggle aria-pressed="false" title="الوضع الليلي" aria-label="تبديل الوضع الليلي">
                  <i class="sicon-moon" aria-hidden="true"></i>
                </button>
              {% endif %}
              <button type="button" class="shamel-header-icon-button shamel-header-menu-toggle" data-shamel-categories-open aria-expanded="false" aria-controls="shamel-categories-drawer" title="أقسام المنتجات" aria-label="فتح أقسام المنتجات">
                <i class="sicon-menu" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  {% if shamel_show_header_categories %}
    <div class="shamel-categories-overlay" data-shamel-categories-overlay hidden></div>
    <aside id="shamel-categories-drawer" class="shamel-categories-drawer" data-shamel-categories-drawer aria-hidden="true" aria-label="أقسام المنتجات">
      <div class="shamel-categories-drawer__head">
        <div>
          <span class="shamel-categories-drawer__eyebrow">تصفّح المتجر</span>
          <h2>أقسام المنتجات</h2>
        </div>
        <button type="button" class="shamel-categories-drawer__close" data-shamel-categories-close aria-label="إغلاق قائمة الأقسام">×</button>
      </div>
      <section class="shamel-drawer-group is-open" data-shamel-drawer-group>
        <button type="button" class="shamel-drawer-group__toggle" data-shamel-drawer-group-toggle aria-expanded="true">
          <span>فئات المنتجات</span><b aria-hidden="true">−</b>
        </button>
        <div class="shamel-drawer-group__content">
          <div class="shamel-categories-drawer__search">
            <salla-search inline oval height="46" aria-label="ابحث داخل المتجر"></salla-search>
          </div>
          <nav class="shamel-categories-drawer__nav" aria-label="الأقسام الرئيسية والفرعية">
            <custom-main-menu></custom-main-menu>
          </nav>
        </div>
      </section>

      <section class="shamel-drawer-group shamel-drawer-filters" data-shamel-drawer-group data-shamel-drawer-filters hidden>
        <button type="button" class="shamel-drawer-group__toggle" data-shamel-drawer-group-toggle aria-expanded="false">
          <span>فلترة المنتجات</span><b aria-hidden="true">+</b>
        </button>
        <div class="shamel-drawer-group__content" data-shamel-drawer-filter-slot></div>
      </section>
    </aside>
  {% endif %}
</header>

<style>
  .shamel-header-main__grid--drawer{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);grid-template-areas:"account brand tools";align-items:center;gap:1rem;min-height:76px}
  .shamel-header-main__account{grid-area:account;display:flex;align-items:center;justify-self:start;gap:.45rem;min-width:0;direction:ltr}
  .shamel-header-main__brand{grid-area:brand;display:flex;align-items:center;justify-content:center;justify-self:center;min-width:0;margin:0}
  .shamel-header-main__brand img{display:block;max-width:175px;max-height:58px;object-fit:contain}
  .shamel-header-main__tools{grid-area:tools;display:flex;align-items:center;justify-self:end;gap:.45rem;min-width:0;direction:ltr}
  .shamel-header-main__account salla-cart-summary,.shamel-header-main__account salla-user-menu,.shamel-header-main__tools>button{flex:0 0 auto}
  .shamel-categories-toggle{display:grid;place-content:center;gap:4px;width:44px;height:44px;padding:0;border:1px solid rgba(148,163,184,.25);border-radius:14px;background:var(--sp-categories-bg,#0b1f3a);color:var(--sp-categories-text,#fff);box-shadow:0 8px 22px rgba(15,23,42,.12);transition:transform .18s ease,box-shadow .18s ease}
  .shamel-categories-toggle:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(15,23,42,.18)}
  .shamel-categories-toggle span{display:block;width:19px;height:2px;border-radius:99px;background:currentColor}
  .shamel-categories-overlay{position:fixed;inset:0;z-index:998;background:rgba(2,6,23,.56);backdrop-filter:blur(3px);opacity:0;transition:opacity .25s ease}
  .shamel-categories-overlay.is-open{opacity:1}
  .shamel-categories-drawer{position:fixed;z-index:999;top:0;right:0;width:min(390px,92vw);height:100dvh;padding:1.2rem;background:#fff;color:#0f172a;box-shadow:-24px 0 60px rgba(2,6,23,.25);transform:translateX(105%);transition:transform .28s cubic-bezier(.22,1,.36,1);overflow:auto}
  .shamel-categories-drawer.is-open{transform:translateX(0)}
  .shamel-categories-drawer__head{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.35rem .2rem 1rem;border-bottom:1px solid #e2e8f0}
  .shamel-categories-drawer__eyebrow{display:block;margin-bottom:.25rem;color:#64748b;font-size:.76rem;font-weight:700}
  .shamel-categories-drawer__head h2{margin:0;font-size:1.25rem;font-weight:800}
  .shamel-categories-drawer__close{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:12px;background:#f1f5f9;color:#0f172a;font-size:1.5rem;line-height:1}
  .shamel-drawer-group{margin-top:1rem;border:1px solid #e2e8f0;border-radius:18px;background:#fff;overflow:hidden}
  .shamel-drawer-group__toggle{display:flex;align-items:center;justify-content:space-between;width:100%;padding:1rem;border:0;background:#eef4ff;color:#0b1f3a;font-size:1rem;font-weight:900;text-align:start}
  .shamel-drawer-group__toggle b{display:grid;place-items:center;width:30px;height:30px;border-radius:10px;background:#0b1f3a;color:#fff;font-size:1.25rem;line-height:1}
  .shamel-drawer-group__content{display:none;padding:.85rem}
  .shamel-drawer-group.is-open>.shamel-drawer-group__content{display:block}
  .shamel-categories-drawer__search{margin:0 0 .85rem}
  .shamel-categories-drawer__nav{padding:.25rem 0}
  .shamel-drawer-filters salla-filters{display:block!important;position:static!important;width:100%!important;max-width:none!important}
  .shamel-categories-drawer__nav custom-main-menu{display:block;min-height:0}
  .shamel-categories-drawer__nav .main-menu{display:flex!important;flex-direction:column!important;align-items:stretch!important;width:100%!important;gap:.35rem!important}
  .shamel-categories-drawer__nav .main-menu>li{display:block!important;width:100%!important}
  .shamel-categories-drawer__nav .main-menu>li>a{display:flex!important;align-items:center!important;justify-content:space-between!important;width:100%!important;padding:.85rem 1rem!important;border:1px solid #e2e8f0!important;border-radius:14px!important;background:#f8fafc!important;color:#0f172a!important;font-weight:700!important}
  .shamel-categories-drawer__nav .sub-menu{position:static!important;width:100%!important;margin-top:.35rem!important;padding:.35rem!important;border:0!important;border-radius:12px!important;box-shadow:none!important;background:#f8fafc!important}
  body.shamel-categories-locked{overflow:hidden}
  body.shamel-dark-mode .shamel-categories-drawer{background:#071a2f;color:#fff}
  body.shamel-dark-mode .shamel-categories-drawer__head{border-color:rgba(255,255,255,.1)}
  body.shamel-dark-mode .shamel-categories-drawer__eyebrow{color:#94a3b8}
  body.shamel-dark-mode .shamel-categories-drawer__close{background:rgba(255,255,255,.09);color:#fff}
  body.shamel-dark-mode .shamel-drawer-group{border-color:rgba(255,255,255,.12);background:#0b2340}
  body.shamel-dark-mode .shamel-drawer-group__toggle{background:#123b72;color:#fff}
  body.shamel-dark-mode .shamel-drawer-group__toggle b{background:#fff;color:#123b72}
  body.shamel-dark-mode .shamel-categories-drawer__nav .main-menu>li>a,body.shamel-dark-mode .shamel-categories-drawer__nav .sub-menu{border-color:rgba(255,255,255,.1)!important;background:rgba(255,255,255,.055)!important;color:#fff!important}
  @media(max-width:640px){
    .shamel-header-main__grid--drawer{grid-template-columns:minmax(74px,1fr) auto minmax(106px,1fr);gap:.35rem;min-height:66px}
    .shamel-header-main__account,.shamel-header-main__tools{gap:.15rem}
    .shamel-header-main__brand img{max-width:112px;max-height:48px}
    .shamel-categories-toggle{width:38px;height:38px;border-radius:12px}
    .shamel-header-dark-toggle{width:38px;height:38px}
    .shamel-header-search-trigger{max-width:38px}
    .shamel-header-search-trigger.is-open{position:absolute;z-index:20;inset-inline:12px;max-width:none}
  }
  @media(max-width:390px){
    .shamel-header-main__grid--drawer{grid-template-columns:minmax(64px,1fr) auto minmax(96px,1fr)}
    .shamel-header-main__brand img{max-width:92px}
  }

  /* Shamel Pro: premium single-row header */
  #mainnav.shamel-header-main{
    background:transparent!important;
    box-shadow:none!important;
    border:0!important;
    padding:14px 0 10px!important;
    overflow:visible!important;
  }
  #mainnav.shamel-header-main .inner,
  #mainnav.shamel-header-main .container{background:transparent!important;overflow:visible!important}
  .shamel-pro-header-shell{
    direction:ltr;
    position:relative;
    min-height:88px;
    padding:10px 22px;
    border:1px solid rgba(107,231,224,.22);
    border-radius:25px;
    background:
      radial-gradient(circle at 50% -80%,rgba(58,210,211,.18),transparent 55%),
      linear-gradient(135deg,#071523 0%,#0b1c2c 56%,#07131f 100%);
    box-shadow:0 18px 45px rgba(1,10,20,.24),inset 0 1px 0 rgba(255,255,255,.06);
    overflow:visible;
  }
  .shamel-header-main__grid--drawer{
    display:grid!important;
    grid-template-columns:minmax(190px,1fr) minmax(210px,340px) minmax(190px,1fr)!important;
    grid-template-areas:"account brand tools"!important;
    align-items:center!important;
    gap:20px!important;
    min-height:66px!important;
  }
  .shamel-header-main__account,
  .shamel-header-main__tools{
    display:flex!important;
    align-items:center!important;
    gap:10px!important;
    min-width:0;
  }
  .shamel-header-main__account{grid-area:account!important;justify-self:start!important;justify-content:flex-start!important;direction:ltr!important}
  .shamel-header-main__tools{grid-area:tools!important;justify-self:end!important;justify-content:flex-end!important;direction:ltr!important}
  .shamel-header-main__brand{
    grid-area:brand!important;
    justify-self:center!important;
    display:flex!important;
    align-items:center!important;
    justify-content:center!important;
    width:min(100%,300px)!important;
    min-width:0!important;
    height:66px!important;
    padding:0 12px!important;
    margin:0!important;
    background:transparent!important;
  }
  .shamel-header-main__brand img{
    display:block!important;
    width:auto!important;
    max-width:100%!important;
    height:auto!important;
    max-height:64px!important;
    object-fit:contain!important;
    filter:drop-shadow(0 5px 14px rgba(0,0,0,.22));
  }
  .shamel-header-icon-button,
  .shamel-header-main__account > salla-cart-summary,
  .shamel-header-main__account > salla-user-menu,
  .shamel-header-localization{
    position:relative;
    display:inline-flex!important;
    align-items:center!important;
    justify-content:center!important;
    width:48px!important;
    min-width:48px!important;
    height:48px!important;
    padding:0!important;
    margin:0!important;
    color:#f7fffe!important;
    border:1px solid rgba(158,232,229,.24)!important;
    border-radius:15px!important;
    background:rgba(255,255,255,.055)!important;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.05)!important;
    transition:transform .2s ease,background .2s ease,border-color .2s ease,box-shadow .2s ease!important;
  }
  .shamel-header-localization{width:auto!important;min-width:64px!important;padding:0 10px!important}
  .shamel-header-icon-button:hover,
  .shamel-header-main__account > salla-cart-summary:hover,
  .shamel-header-main__account > salla-user-menu:hover,
  .shamel-header-localization:hover{
    transform:translateY(-2px);
    color:#fff!important;
    background:rgba(78,213,208,.16)!important;
    border-color:rgba(100,235,229,.56)!important;
    box-shadow:0 10px 22px rgba(0,0,0,.2),0 0 0 3px rgba(60,208,205,.08)!important;
  }
  .shamel-header-icon-button i,
  .shamel-header-main__account .header-btn__icon{
    color:#f7fffe!important;
    font-size:24px!important;
    line-height:1!important;
  }
  .shamel-header-menu-toggle{color:#61ddd7!important;border-color:rgba(97,221,215,.5)!important}
  .shamel-header-menu-toggle i{color:#61ddd7!important;font-size:27px!important}
  .shamel-header-search-trigger{position:relative!important;width:48px!important;height:48px!important;overflow:visible!important}
  .shamel-header-search-panel{
    position:absolute;
    z-index:120;
    top:calc(100% + 14px);
    right:0;
    width:min(420px,80vw);
    padding:10px;
    border:1px solid rgba(107,231,224,.28);
    border-radius:18px;
    background:#0b1a29;
    box-shadow:0 22px 50px rgba(0,0,0,.34);
    opacity:0;
    visibility:hidden;
    pointer-events:none;
    transform:translateY(-8px) scale(.98);
    transform-origin:top left;
    transition:opacity .2s ease,transform .2s ease,visibility .2s ease;
  }
  .shamel-header-search-trigger.is-open .shamel-header-search-panel{
    opacity:1;
    visibility:visible;
    pointer-events:auto;
    transform:none;
  }
  .shamel-header-search-panel salla-search{display:block!important;width:100%!important;color:#fff!important}
  .shamel-header-search-trigger.is-open .shamel-header-search-button{
    color:#071523!important;background:#66ded8!important;border-color:#66ded8!important
  }
  .shamel-header-search-trigger.is-open .shamel-header-search-button i{color:#071523!important}
  @media (max-width:767px){
    #mainnav.shamel-header-main{padding:8px 0!important}
    .shamel-pro-header-shell{min-height:68px;padding:8px 10px;border-radius:19px}
    .shamel-header-main__grid--drawer{
      grid-template-columns:minmax(102px,1fr) minmax(82px,128px) minmax(102px,1fr)!important;
      gap:6px!important;min-height:50px!important
    }
    .shamel-header-main__account,.shamel-header-main__tools{gap:4px!important}
    .shamel-header-icon-button,
    .shamel-header-main__account > salla-cart-summary,
    .shamel-header-main__account > salla-user-menu,
    .shamel-header-localization{
      width:38px!important;min-width:38px!important;height:38px!important;border-radius:12px!important
    }
    .shamel-header-localization{display:none!important}
    .shamel-header-icon-button i,.shamel-header-main__account .header-btn__icon{font-size:20px!important}
    .shamel-header-main__brand{height:48px!important;padding:0 4px!important}
    .shamel-header-main__brand img{max-height:46px!important}
    .shamel-header-search-trigger{width:38px!important;height:38px!important}
    .shamel-header-search-panel{position:fixed;top:78px;right:12px;left:12px;width:auto}
  }
  @media (max-width:390px){
    .shamel-header-main__grid--drawer{grid-template-columns:122px minmax(72px,1fr) 82px!important}
    .shamel-header-main__account{gap:.3rem}
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var searchWrap = document.querySelector('[data-shamel-header-search]');
    if (searchWrap) {
      var searchButton = searchWrap.querySelector('[data-shamel-header-search-button]');
      var searchComponent = searchWrap.querySelector('salla-search');
      function focusHeaderSearch() {
        if (!searchComponent) return;
        if (searchComponent.shadowRoot) {
          var field = searchComponent.shadowRoot.querySelector('input');
          if (field) field.focus();
        }
      }
      function setHeaderSearch(open) {
        searchWrap.classList.toggle('is-open', open);
        if (searchButton) {
          searchButton.setAttribute('aria-expanded', open ? 'true' : 'false');
          searchButton.setAttribute('aria-label', open ? 'إغلاق البحث' : 'فتح البحث');
        }
        if (open) {
          window.setTimeout(focusHeaderSearch, 80);
          window.setTimeout(focusHeaderSearch, 240);
        }
      }
      if (searchButton) {
        searchButton.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          setHeaderSearch(!searchWrap.classList.contains('is-open'));
        });
      }
      var panel = searchWrap.querySelector('.shamel-header-search-panel');
      if (panel) panel.addEventListener('click', function (event) { event.stopPropagation(); });
      document.addEventListener('click', function (event) {
        if (!searchWrap.contains(event.target)) setHeaderSearch(false);
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') setHeaderSearch(false);
      });
    }

    document.querySelectorAll('[data-shamel-drawer-group-toggle]').forEach(function (toggle) {
      toggle.addEventListener('click', function () {
        var group = toggle.closest('[data-shamel-drawer-group]');
        var opening = !group.classList.contains('is-open');
        group.classList.toggle('is-open', opening);
        toggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
        var mark = toggle.querySelector('b');
        if (mark) mark.textContent = opening ? '−' : '+';
      });
    });

    var drawer = document.querySelector('[data-shamel-categories-drawer]');
    var overlay = document.querySelector('[data-shamel-categories-overlay]');
    var openButton = document.querySelector('[data-shamel-categories-open]');
    var closeButton = document.querySelector('[data-shamel-categories-close]');
    if (!drawer || !overlay || !openButton) return;

    function openCategories() {
      overlay.hidden = false;
      window.requestAnimationFrame(function () {
        overlay.classList.add('is-open');
        drawer.classList.add('is-open');
      });
      drawer.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      document.body.classList.add('shamel-categories-locked');
      if (closeButton) closeButton.focus();
    }
    function closeCategories() {
      overlay.classList.remove('is-open');
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('shamel-categories-locked');
      window.setTimeout(function () { overlay.hidden = true; }, 260);
    }
    openButton.addEventListener('click', openCategories);
    if (closeButton) closeButton.addEventListener('click', closeCategories);
    overlay.addEventListener('click', closeCategories);
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && drawer.classList.contains('is-open')) closeCategories();
    });
    drawer.addEventListener('click', function (event) {
      if (event.target.closest('a')) closeCategories();
    });
  });
</script>
