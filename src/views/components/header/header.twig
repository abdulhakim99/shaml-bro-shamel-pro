{#
| Header is intentionally connected to Salla Navigation:
| merchants manage main/sub categories from the store navigation screen.
#}
{% set shamel_show_header_categories = theme.settings.get('shamel_header_categories_enabled_v2', true) %}
<header data-testid="store-header" class="store-header shamel-store-header">
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>
  <div id="mainnav" class="main-nav-container shadow-default bg-white shamel-header-main">
    <div class="inner bg-inherit w-full">
      <div class="container">
        <div class="shamel-header-main__grid{{ shamel_show_header_categories ? '' : ' shamel-header-main__grid--no-menu' }}">
          <div class="shamel-header-main__brand">
            <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none" href="#mobile-menu" aria-label="فتح الأقسام">
              <i class="sicon-menu text-primary text-2xl"></i>
            </a>
            <a data-testid="store-header-logo" class="navbar-brand" href="{{ store.url }}">
              <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
              {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% else %}<h2 class="sr-only">{{ store.name }}</h2>{% endif %}
            </a>
          </div>
          {% if shamel_show_header_categories %}
            <nav class="shamel-header-main__menu" aria-label="أقسام المتجر">
              <custom-main-menu></custom-main-menu>
            </nav>
          {% endif %}
          <div class="shamel-header-main__actions">
            <div class="shamel-header-search-trigger" title="البحث عن المنتجات" data-shamel-header-search>
              <salla-search data-testid="store-header-search" inline oval height="44" aria-label="البحث عن المنتجات"></salla-search>
            </div>
            {% if theme.settings.get('shamel_dark_mode_enabled', true) %}
              <button type="button" class="shamel-header-dark-toggle" data-shamel-dark-toggle aria-pressed="false" title="الوضع الليلي" aria-label="تفعيل الوضع الليلي">
                <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path fill="currentColor" d="M20.7 15.1A8.5 8.5 0 0 1 8.9 3.3 9 9 0 1 0 20.7 15Z"/></svg>
                <span class="sr-only" data-shamel-dark-label>الوضع الليلي</span>
              </button>
            {% endif %}
            {% if store.settings.is_multilingual %}
              <div class="shamel-header-localization" title="اللغة والعملة">
                <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
              </div>
            {% endif %}
            <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
            <salla-cart-summary data-testid="store-header-cart">
              <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
            </salla-cart-summary>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var searchWrap = document.querySelector('[data-shamel-header-search]');
    if (!searchWrap) return;
    var searchComponent = searchWrap.querySelector('salla-search');
    function openHeaderSearch() {
      searchWrap.classList.add('is-open');
      searchWrap.setAttribute('data-open', 'true');
      window.setTimeout(function () {
        if (searchComponent && searchComponent.shadowRoot) {
          var field = searchComponent.shadowRoot.querySelector('input');
          if (field) field.focus();
        }
      }, 80);
    }
    searchWrap.addEventListener('click', openHeaderSearch);
    searchWrap.addEventListener('focusin', openHeaderSearch);
    document.addEventListener('click', function (event) {
      if (!searchWrap.contains(event.target)) {
        searchWrap.classList.remove('is-open');
        searchWrap.removeAttribute('data-open');
      }
    });
  });
</script>
