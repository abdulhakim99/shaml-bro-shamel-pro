{#
| Variable          | Type   | Description                                                      |
|-------------------|--------|------------------------------------------------------------------|
| title             | string | Section title                                                    |
| items[]           | array  | List of images                                                   |
| items[].url       | string |                                                                  |
| items[].link_type | string | category,product,offers,page,external_link,brand                 |
| items[].image.url | string |                                                                  |
| items[].image.alt | string |                                                                  |
| items[].text      | string | Visible title for the photo                                      |
| position          | Int    | Sorting number start from zero                                   |
#}
{% if items|length %}
<section data-testid="store-home-square-photos" class="s-block s-block--banners container">
    {% if title %}
        <div class="s-block__title">
            <div class="right-side">
                <h2>{{ title }}</h2>
            </div>
        </div>
    {% endif %}

    <div class="grid {{ items|length <= 3 ? 'one-row md:grid-cols-' ~ items|length : 'md:grid-cols-3 two-row' }} grid-flow-row gap-3 sm:gap-8">
        {% for item in items %}
            {% if item.image.url %}
                {% set image_alt = item.image.alt ? item.image.alt : (item.text ? item.text : '') %}
                {% set image_label = image_alt ? image_alt : 'عرض الصورة' %}
                {% if item.url %}
                    <a class="banner-entry square-photos {{ item.text ? 'has-overlay with-hover' : '' }}" href="{{ item.url }}" aria-label="{{ image_label|e('html_attr') }}"{% if item.link_type == 'external_link' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {% else %}
                    <div class="banner-entry square-photos {{ item.text ? 'has-overlay with-hover' : '' }}">
                {% endif %}
                        <div class="lazy__bg lazy bg-no-repeat" data-bg="{{ item.image.url }}"
                            style="background-size: {{ theme.settings.get('squar_photo_bg_image_size', 'contain') }};"
                            {% if image_alt %}role="img" aria-label="{{ image_alt|e('html_attr') }}"{% else %}aria-hidden="true"{% endif %}></div>
                        {% if item.text %}
                            <h3 class="text-with-border"><span>{{ item.text }}</span></h3>
                        {% endif %}
                {% if item.url %}
                    </a>
                {% else %}
                    </div>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}
