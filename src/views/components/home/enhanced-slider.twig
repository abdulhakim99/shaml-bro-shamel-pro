{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component                      | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides               | object[] | list of slides                                                               |
| position                       | int      | Sorting number start from zero                                               |
#}
{% set shamel_identity_raw = theme.settings.get('shamel_store_identity', 'general') %}
{% set shamel_identity = shamel_identity_raw is iterable ? (shamel_identity_raw|first).value : shamel_identity_raw %}
{% set shamel_hero_variant = 'split' %}
{% if shamel_identity == 'digital' %}{% set shamel_hero_variant = 'platform' %}
{% elseif shamel_identity == 'perfume' %}{% set shamel_hero_variant = 'campaign' %}
{% elseif shamel_identity == 'fashion' %}{% set shamel_hero_variant = 'editorial' %}
{% elseif shamel_identity == 'electronics' %}{% set shamel_hero_variant = 'collection' %}
{% elseif shamel_identity == 'gaming' %}{% set shamel_hero_variant = 'platform' %}{% endif %}
<section data-testid="store-home-slider" data-shamel-hero-variant="{{ shamel_hero_variant }}" class="s-block s-block--hero-slider s-block--full-bg wide-placeholder shamel-hero--{{ shamel_hero_variant }}">
    <salla-slider 
      id="main-slider-{{ position }}"
      auto-play
      static-when-single
      slider-config='{"lazy":"false"}'
      {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}
      type="fullwidth">
        <div slot="items">
            {% for slide in component.slides %}
                <div class="swiper-slide w-full min-h-[300px] lg:min-h-[528px] bg-dark relative">
					<div style="background-image: url({{ slide.image }});" class="{{ slide.without_overlay ? '' : 'overlay-bg' }} bg-cover bg-center absolute inset-0"></div>
                    {% if slide.title or slide.description %}
                      <div class="flex-center container pb-16 sm:pb-0 home-slider__content relative h-full">
                          <div class="w-4/6 text-center md:w-7/12 lg:w-5/12 text-white">
                              {% if slide.title %}
                                <h2 data-swiper-parallax="-500" class="lg:text-title-size font-bold leading-tight mb-4">{{ slide.title }}</h2>
                              {% endif %}
                              {% if slide.description %}
                                <p data-swiper-parallax="-300" class="line-clamp-2 description">{{ slide.description }}</p>
                              {% endif %}
                          </div>
                      </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section> 
