{#
| Variable                        | Type     | Description                                                                  |
|---------------------------------|----------|------------------------------------------------------------------------------|
| component                       | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.banners               | object[] | list of banners                                                              |
| component.banners[].image       | string   |                                                                              |
| component.banners[].url         | string   |                                                                              |
| component.banners[].title       | ?string  |                                                                              |
| component.banners[].description | ?string  |                                                                              |
| position                        | int      | Sorting number start from zero                                               |
#}

<section data-testid="store-home-square-banners" class="s-block s-block--banners container">
    <div class="grid {{ component.banners|length <= 3 ? 'md:grid-cols-' ~ component.banners|length : 'md:grid-cols-3 two-row' }} grid-flow-row gap-3 sm:gap-8">
        {% for index, banner in component.banners %}
            {% set banner_has_text = banner.title or banner.description %}
            {% set banner_label = banner.title ? banner.title : (banner.description ? banner.description : 'عرض البانر') %}
            {% if banner.url %}
                <a href="{{ banner.url }}" aria-label="{{ banner_label|e('html_attr') }}" class="banner-entry lazy {{ banner_has_text ? 'has-overlay' : '' }} {{ component.banners|length <= 3 ? 'h-lg-banner' : 'h-banner' }}" data-bg="{{ banner.image }}">
                    {% if banner_has_text %}
                        <article class="banner-entry__text text-with-border">
                            {% if banner.title %}<h3 class="banner__title font-bold mb-1 leading-6">{{ banner.title }}</h3>{% endif %}
                            {% if banner.description %}<p class="banner__description">{{ banner.description }}</p>{% endif %}
                        </article>
                    {% endif %}
                </a>
            {% else %}
                <div class="banner-entry lazy {{ banner_has_text ? 'has-overlay' : '' }} {{ component.banners|length <= 3 ? 'h-lg-banner' : 'h-banner' }}" data-bg="{{ banner.image }}"{{ banner_has_text ? ' role="group"' : ' aria-hidden="true"' }}>
                    {% if banner_has_text %}
                        <article class="banner-entry__text text-with-border">
                            {% if banner.title %}<h3 class="banner__title font-bold mb-1 leading-6">{{ banner.title }}</h3>{% endif %}
                            {% if banner.description %}<p class="banner__description">{{ banner.description }}</p>{% endif %}
                        </article>
                    {% endif %}
                </div>
            {% endif %}
        {% endfor %}
    </div>
</section>
